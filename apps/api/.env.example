# The application role. Row-level security binds it; the server refuses to start
# as a superuser or BYPASSRLS role. Created by scripts/setup.sh (scripts/app-role.sql).
DATABASE_URL="postgresql://kaizen_app:kaizen_app@127.0.0.1:5432/kaizen?schema=public"
# The owner. Migrations run as this role (schema directUrl).
MIGRATION_DATABASE_URL="postgresql://kaizen:kaizen@127.0.0.1:5432/kaizen?schema=public"
# The role behind the cross-tenant jobs, the audit chain and the seed. Needs BYPASSRLS;
# required when NODE_ENV=production.
UNSCOPED_DATABASE_URL="postgresql://kaizen:kaizen@127.0.0.1:5432/kaizen?schema=public"
# At least 32 characters; boot refuses anything shorter. Generate with: openssl rand -base64 48
JWT_SECRET=
PORT=4000
JOBS_ENABLED=true
NODE_ENV=development
# Required in every environment: the API will not boot without it. It keys
# encryption of PAN, Aadhaar and bank values, so it must be private to the
# deployment. Changing it makes values already encrypted under the old key
# unreadable. Generate with: openssl rand -base64 48
FIELD_ENCRYPTION_KEY=
# Document bytes (objectStorage.ts). A local directory until hosting is chosen; unset, uploads are refused.
# DOCUMENT_STORAGE_DIR=/var/lib/kaizen/documents
