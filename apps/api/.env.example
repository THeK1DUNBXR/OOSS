DATABASE_URL="postgresql://kaizen:kaizen@127.0.0.1:5432/kaizen?schema=public"
# At least 32 characters; boot refuses anything shorter. Generate with: openssl rand -base64 48
JWT_SECRET=
PORT=4000
JOBS_ENABLED=true
NODE_ENV=development
# Required when NODE_ENV=production (the process will not boot without it).
# Outside production the public development key is used with a warning.
# Generate with: openssl rand -base64 48
# FIELD_ENCRYPTION_KEY=
