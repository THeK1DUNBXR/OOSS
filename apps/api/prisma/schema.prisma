// Kaizen Unified Operating Platform — data model.
//
// Two structural facts hold across every model and are not restated per entity:
//
//   1. `tenantId` is present on every row from creation (CRM-FOUND-001). Every
//      compound index is tenant-leading, so a cross-tenant scan is never
//      index-eligible. Every previously-global unique constraint is
//      tenant-scoped.
//   2. Every entity carrying a human-readable identifier uses the unified
//      record-code scheme <TYPE>-<YYYY>-<NNNNN> (CRM-FOUND-007), generated per
//      tenant per type, gapless within a year, immutable after creation.
//
// Soft delete is `deletedAt`, never a hard delete, on every governed entity.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// P0 — Tenancy & Trust Fabric
// ===========================================================================

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String   @default("active") // active | suspended | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The explicit bootstrap authority set — who may create the first POLICY or
  /// GRANT for a new tenant. Owned by SYS, it breaks the circularity of the
  /// permission system needing permission to create itself.
  ///
  /// Also carries, by convention (documented as `TenantConfig` in
  /// `@kaizen/shared`): `emailDomains: string[]` (a routing hint only — see
  /// `apps/api/src/lib/auth.ts`), `originDivision` (the division a subsidiary
  /// grew out of, before it existed as its own tenant) and
  /// `smallCompanyNoticeRaisedAt` (set once `reconcileTenantKinds` has raised
  /// the §1a.1 compliance notice, so it fires exactly once).
  config Json @default("{}")

  /// The group. A tenant with a parent is a `subsidiary`; a tenant another
  /// tenant names as parent is a `holding`; anything else is `standalone`.
  /// Recomputed by `reconcileTenantKinds` rather than trusted as written, so it
  /// can never go stale the way a hand-set flag would.
  parentTenantId String?
  parent         Tenant?  @relation("TenantGroup", fields: [parentTenantId], references: [id], onDelete: Restrict)
  subsidiaries   Tenant[] @relation("TenantGroup")
  kind           String   @default("standalone") // holding | subsidiary | standalone

  users           User[]
  people          Person[]
  organizations   Organization[]
  events          EventRecord[]
  recordSequences RecordSequence[]

  @@map("tenants")
}

/// Per-tenant, per-type, per-year sequence backing the record-code generator.
/// Gapless within the year; an atomic increment guarantees no two records
/// receive the same sequence under concurrency.
model RecordSequence {
  id           String @id @default(cuid())
  tenantId     String
  entityType   String
  year         Int
  nextSequence Int    @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType, year])
  @@map("record_sequences")
}

/// Who the company is, on paper.
///
/// A tax invoice is not a list of lines with a total: it is a statement by one
/// registered person to another, and it is invalid without the supplier's legal
/// name, address and GSTIN on it. A GST return is filed *under* a GSTIN. None
/// of that was anywhere in the model — the invoice screen could total a sale
/// and could not produce a document anybody could lawfully hand over, and the
/// GST summary was a set of figures with no registration attached.
///
/// One row per tenant. The bank details are here because an invoice a customer
/// cannot pay from is half a document; they are printed by design rather than
/// leaked, which is why they are named for what they are rather than hidden
/// behind the regulated `bankAccountReference` exclusion.
model CompanyProfile {
  id       String @id @default(cuid())
  tenantId String @unique

  legalName String
  tradeName String?

  /// The registration outward supplies are made under and returns are filed
  /// against. `stateCode` is its first two digits, held separately so a place
  /// of supply can be compared against it without re-parsing a GSTIN every
  /// time — and so a tenant that has not registered yet is representable.
  gstin     String?
  stateCode String?
  stateName String?
  pan       String?
  cin       String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  pincode      String?
  email        String?
  phone        String?
  website      String?

  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankBranch        String?
  upiId             String?

  /// Printed under every invoice. Terms are the conditions of the sale; notes
  /// are whatever this company always wants to say.
  invoiceTerms   String?
  invoiceNotes   String?
  defaultDueDays Int     @default(30)

  /// The company's own short code, which every customer-facing document number
  /// begins with: `KIPL/I/2026-27/001`.
  ///
  /// Defaulted from the initials of the legal name on first use, because that is
  /// what a company's own numbering almost always is, and editable because
  /// sometimes it is not. The letter in the middle says which series — `I` for a
  /// tax invoice, `R` for a receipt, `F` for a final invoice — and the year is
  /// the financial year, which is when each series restarts.
  documentPrefix String?

  /// How the financial year is written in a document number: `short` gives
  /// `26-27`, `full` gives `2026-27`.
  ///
  /// It exists because of a hard limit somebody has to be told about. The portal
  /// accepts a tax invoice number of at most sixteen characters, and
  /// `KIPL/I/2026-27/001` is eighteen — a number that reads perfectly on paper
  /// and is rejected by GSTR-1. `KIPL/I/26-27/001` is exactly sixteen, which is
  /// why `short` is the default: a default that cannot be filed is not a
  /// default. `full` stays available for a company with a shorter prefix, or one
  /// that would rather match its existing paper series and accept the
  /// consequence — which the returns screen states rather than discovers.
  documentYearFormat String @default("short")

  /// The register (equity-portal plan §5 "EntityProfile"). Held on the same
  /// row as the rest of the company's own facts rather than a second 1:1
  /// table, for the same reason `documentPrefix` is here: one thing a tenant
  /// has one of.
  incorporatedOn         DateTime?
  financialYearEndMonth  Int?      @default(3)
  /// null = not stated. A stated false is a fact worth keeping once a
  /// subsidiary exists and `reconcileTenantKinds` has already ended it —
  /// the flag is not derived from that, because s.2(85) turns on group
  /// structure, not on this column.
  isSmallCompany         Boolean?
  dematStatus            String    @default("physical") // physical | demat | mixed
  isin                   String?
  rtaName                String?
  dpiitNumber            String?
  dpiitRecognisedOn      DateTime?
  /// Snapshotted onto every certificate at issue (s.46: two signatories).
  /// `[]` until the secretary sets it, which is exactly why `makeEffective`
  /// refuses to issue a certificate against an empty list rather than
  /// printing one signatory short.
  certificateSignatories Json      @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("company_profiles")
}

// ===========================================================================
// P1 — Party & Identity
// ===========================================================================

/// One PERSON row per real human, forever. PERSON itself never records a role
/// or a relationship — that is what AFFILIATION and RELATIONSHIP are for.
///
/// Phone/email indexes are deliberately NOT unique: a 409-with-candidates from
/// the dedup service is the mechanism, not a driver-level duplicate-key error.
model Person {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  fullName                   String
  primaryPhone               String?
  primaryEmail               String?
  primaryPhoneNormalised     String?
  primaryEmailNormalised     String?
  additionalPhones           String[] @default([])
  additionalEmails           String[] @default([])
  additionalPhonesNormalised String[] @default([])
  additionalEmailsNormalised String[] @default([])

  /// {system, id} pairs. Never fabricated — absent is safe, wrong is not.
  externalIds Json @default("[]")

  /// Date of birth. Held because half of HR depends on it — age at joining,
  /// retirement, statutory minimums — and because a staff list carries it.
  dateOfBirth DateTime?

  /// Blood group, from the staff list that carries it for emergencies.
  ///
  /// Health data under the DPDP Act, so it is registered as `regulated` and is
  /// structurally excluded from any projection whose viewer's ceiling does not
  /// reach it — absent from the response shape, not present-and-null.
  bloodGroup String?

  dedupeStatus String   @default("active") // active | merged | flagged_duplicate
  mergedIntoId String?
  mergedInto   Person?  @relation("PersonMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Person[] @relation("PersonMerge")

  /// Field-level sensitivity classification consulted by both the write-audit
  /// path and the regulated-field read-audit path.
  fieldClassifications Json @default("{}")

  notes       String?
  createdById String?
  updatedById String?
  source      String    @default("manual")
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  affiliations   Affiliation[]
  users          User[]
  leads          Lead[]
  studentProfile StudentProfile?

  /// A candidate and an employee are the same Person row. Being hired adds an
  /// employment relationship and an affiliation; it never creates a second human.
  employmentRelationships EmploymentRelationship[]
  candidateApplications   Application[]            @relation("ApplicationCandidate")

  @@unique([tenantId, recordCode])
  @@index([tenantId, primaryPhoneNormalised])
  @@index([tenantId, primaryEmailNormalised])
  @@index([tenantId, dedupeStatus])
  @@index([tenantId, fullName])
  @@map("people")
}

/// A time-bounded record of HOW a PERSON relates to Kaizen right now. A person
/// can hold multiple active affiliations simultaneously. Access and visibility
/// derive from Affiliations, never from PERSON directly.
model Affiliation {
  id       String @id @default(cuid())
  tenantId String

  partyId          String
  party            Person  @relation(fields: [partyId], references: [id], onDelete: Cascade)
  counterpartyId   String?
  counterpartyName String?
  affiliationType  String // employee | student | customer_contact | ...

  /// The ACCESS_ROLE this affiliation carries. Never a permission itself —
  /// a GRANT references a role and a POLICY_VERSION.
  roleSlug String?

  status             String    @default("active") // active | suspended | ended
  primaryFlag        Boolean   @default(false)
  specialisationId   String?
  effectiveFrom      DateTime  @default(now())
  effectiveTo        DateTime?
  priorAffiliationId String?

  /// Employee/student affiliations carry a statutory retention floor: a dedup
  /// match against one never auto-merges, regardless of confidence.
  statutoryRetentionFloor Boolean @default(false)

  orgUnitId  String?
  branch     String?
  positionId String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, partyId, status])
  @@index([tenantId, affiliationType, status])
  @@map("affiliations")
}

/// Raised whenever a dedup match is ambiguous, cross-scope, or hits a statutory
/// retention floor. Drained by human action, never auto-expired.
model MergeCandidate {
  id       String @id @default(cuid())
  tenantId String

  incomingPayload   Json
  candidatePersonId String
  confidence        Float
  matchedOn         String[] @default([])
  raisedReason      String // cross_scope | ambiguous | statutory_retention_floor
  state             String   @default("open") // open | confirmed | rejected | deferred

  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, state, createdAt])
  @@map("merge_candidates")
}

/// The single Party-model specialisation for any legal or institutional body —
/// one row per real legal body, forever. `category` as an exclusive gate is
/// removed; `legacyCategory` survives transitionally for reporting only.
model Organization {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  /// What this body *is*: `institution` — a school or a college — or
  /// `organization` — a trust, a foundation or a business.
  ///
  /// Exclusive, and enforced. The two used to be specialisations that could sit
  /// on one row at once, on the reasoning that a college might also buy
  /// training and keeping two records of one legal body is how a CRM starts
  /// lying to you. In practice it meant every list mixed schools with firms,
  /// every screen had to say "companies & colleges", and the word "customer"
  /// ended up covering a fifteen-year-old learner, a government polytechnic and
  /// a manufacturing company — three parties with nothing in common except that
  /// money sometimes moves. They are separated here because they are read,
  /// billed, reported and worked differently.
  ///
  /// A college we also invoice is still one row: billing detail is not identity,
  /// and an institution carries it the same way an organisation does.
  kind String @default("organization")

  /// What this body *does with us*, which is a different question from what it
  /// is, and not exclusive: a manufacturer can fund a CSR cohort and hire out
  /// of it, and the best relationships are both.
  ///
  /// `client` buys from us — software, or training for its own staff.
  /// `sponsor` funds somebody else's learners.
  /// `employer` takes people at the end of a cohort.
  /// `government` is a department or state skill agency appointing partners.
  ///
  /// Empty on an institution, whose engagements are recorded on its own profile
  /// in the vocabulary colleges are actually described in.
  roles String[] @default([])

  name        String
  website     String?
  parentOrgId String?
  parentOrg   Organization?  @relation("OrgHierarchy", fields: [parentOrgId], references: [id])
  children    Organization[] @relation("OrgHierarchy")

  locations    Json     @default("[]")
  tags         String[] @default([])
  ownerPartyId String?

  legacyCategory String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account            Account?
  institutionProfile InstitutionProfile?
  leads              Lead[]
  opportunities      Opportunity[]
  /// Students recruited out of this organisation, when it is a college.
  sentStudents       Enrollment[]        @relation("EnrollmentInstitution")
  /// And the learners whose own record names it as where they came from.
  students           StudentProfile[]    @relation("StudentInstitution")
  /// The learners whose fees this body is paying.
  sponsoredStudents  StudentProfile[]    @relation("StudentSponsor")

  @@unique([tenantId, recordCode])
  @@index([tenantId, name])
  @@index([tenantId, kind, name])
  @@map("organizations")
}

/// How an organisation is billed: terms, the address the invoice goes to, and
/// the registration the tax is charged under.
///
/// It hangs off either kind, because being invoiced is not what makes a body a
/// business. A polytechnic that buys a staff training programme is billed
/// exactly like a manufacturer, and the difference between them belongs in
/// `Organization.kind` and in InstitutionProfile, not in whether they are
/// allowed to have payment terms. A student's equivalent lives on
/// StudentProfile, for the same reason and with the same fields.
model Account {
  id       String @id @default(cuid())
  tenantId String

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tier             String  @default("standard") // strategic | key | standard | long_tail
  ownerPartyId     String?
  billingEmail     String?
  billingAddress   String?
  paymentTermsDays Int?

  /// The customer's registration, and the state the supply is made to.
  ///
  /// Both belong to the account rather than to each invoice: they do not change
  /// from sale to sale, and the GST split — CGST+SGST within the state, IGST
  /// across it — is wrong rather than untidy when somebody retypes them and
  /// gets one digit out. The invoice still stores its own copy, because the
  /// tax was charged under one reading of them and reprinting must not restate
  /// it if the account is later corrected.
  gstin             String?
  placeOfSupply     String?
  annualRevenueBand String?
  employeeCountBand String?

  attachedById String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, tier])
  @@map("accounts")
}

/// The education/institutional-partnership specialisation. Formerly the
/// conditionally-null `institution_details` sub-document; now a sibling
/// specialisation governed by its own `institutions:*` grant family.
model InstitutionProfile {
  id       String @id @default(cuid())
  tenantId String

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  institutionType String?
  managementType  String?
  address         String?
  district        String?
  taluk           String?
  state           String?
  latitude        Float?
  longitude       Float?

  /// AISHE/UDISE+ — never fabricated; left null instead.
  externalIdentifier String?
  establishedYear    Int?
  studentCount       Int?
  departments        String[] @default([])
  strategicPriority  String?

  /// Which of the five depths this partnership actually runs at — academic
  /// alignment, faculty development, student capability, research and
  /// innovation, a centre of excellence, institutional technology.
  ///
  /// A college is not one relationship. "We run their faculty development" and
  /// "we built their admissions portal" are different engagements with
  /// different people and different money, and a partnership recorded only as
  /// "active" says which of them is true to nobody.
  engagements String[] @default([])

  /// NAAC grade, NBA accreditation, an autonomous status — whatever the
  /// institution leads with. Their outcome and accreditation reporting is a
  /// thing we help with, so knowing where they stand is part of the record.
  accreditation String?

  attachedById String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, district, institutionType])
  @@index([tenantId, externalIdentifier])
  @@map("institution_profiles")
}

/// The learner specialisation on a PERSON: somebody who buys and takes a course.
///
/// A student is a person, and the platform already has exactly one row per real
/// human — the merge and dedupe machinery, the employment history and the
/// contact graph all hang off it, and a second table of students would mean a
/// second row for the graduate you later hire. So a student is a PERSON wearing
/// this profile, the same shape institutions and billing already use.
///
/// What it is *not* is a kind of organisation. A student who walks in and pays
/// for a course is the customer on that invoice; a college that sends thirty
/// students is a different party doing a different thing, and putting both
/// under one "customer" list made it impossible to answer either "how many
/// learners do we have" or "which colleges do we work with".
model StudentProfile {
  id       String @id @default(cuid())
  tenantId String

  personId String @unique
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  /// The company's own registration number for this student — `KI-2026/09-SAP/1107`
  /// and the like. Theirs, not ours: it arrives on the register and is quoted
  /// back at us, so it is stored as given and not reissued.
  registrationNumber String?

  /// The college or school they came from, where they came from one. Null for
  /// somebody who walked in off the street, which is most of them.
  institutionId String?
  institution   Organization? @relation("StudentInstitution", fields: [institutionId], references: [id])

  /// prospective | active | alumni | withdrawn. Follows from their enrolments
  /// rather than being set by hand wherever it can be.
  status String @default("prospective")

  /// Who is actually paying for their place: `self`, `sponsor`, `scheme` or
  /// `institution`.
  ///
  /// The most consequential fact on this record, because the platform bills
  /// people. A beneficiary of a funded cohort owes nothing, and an invoice
  /// raised to them is a document that should never have existed — while the
  /// learner sitting next to them, who walked in and paid, gets one. The two sit
  /// in the same classroom, so this belongs on the learner and not on the course.
  funding String @default("self")

  /// The body paying, when somebody else is. An organisation for a CSR or
  /// employer sponsor; the institution they came from when the college is
  /// paying. Checked against `funding` on the way in.
  sponsorId String?
  sponsor   Organization? @relation("StudentSponsor", fields: [sponsorId], references: [id])

  /// Which framework the money comes under — Naan Mudhalvan, Vetri Nichayam, a
  /// TNSDC or NSDC-linked scheme, CSR. Each has its own documentation standard
  /// and reporting expectation, so "which of our learners are on this scheme"
  /// has to be answerable from a field rather than from a note.
  fundingFramework String?

  /// Madurai, Coimbatore, online, or on their own campus.
  deliveryLocation String?

  address String?

  /// Where the supply is made to, for the tax split, and a registration on the
  /// rare student who has one — a proprietor putting their own training through
  /// the firm. The same two fields Account carries, for the same reason: they do
  /// not change from sale to sale, and retyping them is how the wrong tax gets
  /// charged.
  placeOfSupply String?
  gstin         String?

  attachedById String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, registrationNumber])
  @@index([tenantId, status])
  @@index([tenantId, institutionId])
  @@index([tenantId, funding])
  @@index([tenantId, sponsorId])
  @@index([tenantId, fundingFramework])
  @@map("student_profiles")
}

// ===========================================================================
// P3 — Relationship Graph
// ===========================================================================

/// A first-class polymorphic edge. History is preserved by never overwriting a
/// Relationship in place when its nature changes — a new role or employer
/// produces a NEW row with its own startDate, and the prior one gets an endDate.
/// `status` and `strength` alone may be updated in place: refinements of the
/// same ongoing relationship, not nature changes.
model Relationship {
  id       String @id @default(cuid())
  tenantId String

  fromType String
  fromId   String
  toType   String
  toId     String

  relationshipType String
  role             String?
  status           String  @default("active") // active | inactive | ended
  strength         String  @default("moderate") // weak | moderate | strong
  ownerPartyId     String?

  startDate DateTime  @default(now())
  endDate   DateTime?
  notes     String?

  supersededById String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, fromType, fromId])
  @@index([tenantId, toType, toId])
  @@index([tenantId, relationshipType, status])
  @@map("relationships")
}

// ===========================================================================
// P7 — Governance: policies, grants, roles, decisions
// ===========================================================================

/// Retained as the ACCESS_ROLE reference. It stops being the terminus of the
/// permission chain — a GRANT references a Role AND a POLICY_VERSION.
model AccessRole {
  id       String @id @default(cuid())
  tenantId String

  slug                  String
  name                  String
  description           String?
  archetype             String   @default("workspace") // command | workspace | portal | console
  /// The WHAT-axis ceiling this role may read up to.
  classificationCeiling String   @default("internal")
  isSystem              Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  grants Grant[]

  @@unique([tenantId, slug])
  @@map("access_roles")
}

/// A named, versioned rule set. POLICY_VERSION is an immutable snapshot
/// referenced by any decision that relied on it, so a past decision stays
/// re-explainable against the rule in force at decision time.
model Policy {
  id       String @id @default(cuid())
  tenantId String

  policyCode       String // POL-CRM-MOU-APPROVAL
  name             String
  description      String?
  kind             String  @default("permission") // permission | approval_gate | threshold
  currentVersionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions PolicyVersion[]

  @@unique([tenantId, policyCode])
  @@map("policies")
}

model PolicyVersion {
  id       String @id @default(cuid())
  tenantId String

  policyId String
  policy   Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  version  Int

  /// The rule content: required_permission, authority_test,
  /// approver_resolution, the Self-Dealing Bar clause, applies_to.
  content Json

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  authoredById  String?
  createdAt     DateTime  @default(now())

  grants Grant[]

  @@unique([policyId, version])
  @@index([tenantId, effectiveFrom])
  @@map("policy_versions")
}

/// The durable record of "this role or principal may take this action on this
/// resource", replacing the disposable roles-collection projection the legacy
/// migration overwrote on every deploy.
model Grant {
  id       String @id @default(cuid())
  tenantId String

  principalType String      @default("role") // role | individual | agent
  roleId        String?
  role          AccessRole? @relation(fields: [roleId], references: [id], onDelete: Cascade)
  principalId   String?

  policyVersionId String?
  policyVersion   PolicyVersion? @relation(fields: [policyVersionId], references: [id])

  resource String
  verbs    String[] // view | create | edit | delete | assign | export | financial | approve | merge
  scope    String   @default("all") // own | own_or_unowned | all

  /// Extra scope resolvers beyond own/own_or_unowned — e.g. `batch_member`,
  /// which expresses "trainer scoped to own batch" as data rather than as six
  /// hard-coded role-slug comparisons in service code.
  scopeResolver String?
  conditions    Json    @default("{}")

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId, roleId, resource])
  @@index([tenantId, principalId, resource])
  @@map("grants")
}

/// The HOW MUCH axis — a value, count, or risk-class limit bound to a principal,
/// human or agent. A principal with no resolvable AUTHORITY_GRANT defaults to
/// "no elevated authority": fail-closed, not fail-open.
model AuthorityGrant {
  id       String @id @default(cuid())
  tenantId String

  principalType  String // human | agent
  principalId    String
  principalLabel String?

  authorityClass   String // mou_approval | contract_approval | discount_approval | agent_draft
  ceilingValue     Decimal? @db.Decimal(18, 2)
  currency         String?
  countCeiling     Int?
  countWindow      String?
  riskClassCeiling String?

  status        String    @default("active") // active | paused | revoked
  grantedById   String?
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  revokedAt     DateTime?
  revokedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, principalId, authorityClass])
  @@map("authority_grants")
}

/// An approval gate instance opened by a privileged transition or an
/// over-ceiling action.
model ApprovalStep {
  id       String @id @default(cuid())
  tenantId String

  policyId      String?
  policyVersion Int?
  subjectType   String
  subjectId     String
  subjectLabel  String?
  action        String // mou.approve | contract.sign | quote.issue

  requestedById  String
  requestedAt    DateTime @default(now())
  requestedValue Decimal? @db.Decimal(18, 2)
  currency       String?

  /// Resolved deterministically, before any notification fires.
  resolvedApproverId    String?
  resolvedApproverRole  String?
  resolutionTier        Int     @default(0)
  /// Set when the Self-Dealing Bar rerouted resolution to the next tier.
  selfDealingBarTripped Boolean @default(false)

  state        String    @default("open") // open | approved | declined | escalated | withdrawn
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?

  slaDueAt       DateTime?
  escalatedAt    DateTime?
  escalationRung Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, state, slaDueAt])
  @@index([tenantId, resolvedApproverId, state])
  @@map("approval_steps")
}

/// A governance decision routed to a principal whose authority genuinely
/// exceeds every grant below them on the escalation path.
model Decision {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  question     String
  state        String  @default("Raised")
  subjectType  String
  subjectId    String
  subjectLabel String?

  authorityBasis         String
  requiredAuthorityValue Decimal? @db.Decimal(18, 2)
  currency               String?
  routedToPartyId        String?
  routedToRole           String?

  /// The seven mandatory components, assembled before routing, never after.
  evidencePack     Json    @default("{}")
  evidenceComplete Boolean @default(false)

  /// Recorded before the outcome is known — the raw material for the
  /// decision-quality calibration widget.
  confidence Float?

  chosenOption      String?
  rationale         String?
  rationaleAudioRef String?
  decidedById       String?
  decidedAt         DateTime?

  deferUntil               DateTime?
  pointOfNoReturn          DateTime?
  reviewDueOn              DateTime?
  outcomeAssessment        String?
  varianceBand             String?
  changeCommitment         String?
  changeCommitmentResolved Boolean   @default(false)

  raisedAt  DateTime  @default(now())
  slaDueAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  delegations Delegation[]

  @@unique([tenantId, recordCode])
  @@index([tenantId, state, raisedAt])
  @@index([tenantId, routedToPartyId, state])
  @@map("decisions")
}

/// Bounded, named, dated. No sub-delegation.
model Delegation {
  id       String @id @default(cuid())
  tenantId String

  decisionId String?
  decision   Decision? @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  fromPartyId String
  toPartyId   String
  scope       String
  reason      String

  effectiveFrom      DateTime  @default(now())
  returnDueOn        DateTime
  returnedAt         DateTime?
  returnedUnactioned Boolean   @default(false)
  state              String    @default("active") // active | returned | expired

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, toPartyId, state])
  @@map("delegations")
}

// ===========================================================================
// P4 — Event Fabric
// ===========================================================================

/// Durable, append-only, hash-chained, replayable. Every fact-changing action
/// writes one. Reads never emit events — a read of confidential or regulated
/// data produces an AUDIT_RECORD instead.
model EventRecord {
  id       String @id @default(cuid())
  tenantId String

  eventId      String
  eventName    String
  eventVersion Int    @default(1)

  occurredAt DateTime
  recordedAt DateTime @default(now())

  actorType         String
  actorPartyId      String?
  actorAccessRole   String?
  actorAgentId      String?
  onBehalfOfPartyId String?

  subjectEntityType String
  subjectEntityId   String
  subjectRecordCode String?

  related           Json     @default("[]")
  previousState     Json?
  newState          Json?
  reason            Json?
  source            Json     @default("{}")
  impactDomains     String[] @default([])
  impactSeverity    String?
  impactMateriality Json?
  ownerPartyId      String?
  ownerPositionId   String?

  correlationId String
  causationId   String?

  confidentiality String @default("internal")
  retentionClass  String @default("standard")

  /// The hash-chain linkage that makes the log tamper-evident and replayable.
  /// A chain-continuity failure alerts per tenant, never merely logs.
  prevHash String?
  hash     String

  /// Set during the dual-publish migration window so both names are
  /// recognisable as the same fact.
  legacyName String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventId, eventName])
  @@index([tenantId, recordedAt])
  @@index([tenantId, eventName, occurredAt])
  @@index([tenantId, subjectEntityType, subjectEntityId])
  @@index([tenantId, correlationId])
  @@map("event_records")
}

/// A handler's third failure writes here rather than only logging, so a process
/// restart does not lose an in-flight retry.
model EventDeadLetter {
  id       String @id @default(cuid())
  tenantId String

  eventRecordId String
  eventName     String
  subscriberKey String
  attempts      Int    @default(0)
  lastError     String
  payload       Json

  state      String    @default("dead") // pending | dead | replayed
  createdAt  DateTime  @default(now())
  replayedAt DateTime?

  @@index([tenantId, state, createdAt])
  @@map("event_dead_letters")
}

// ===========================================================================
// Audit
// ===========================================================================

/// Append-only, no update or delete path. Write-audit for every governed
/// entity; read-audit for regulated fields only, preserving the original
/// performance-driven design for the common case.
model AuditRecord {
  id       String @id @default(cuid())
  tenantId String

  action      String // create | update | delete | merge | export | login | permission_change | read
  subjectType String
  subjectId   String

  actorType    String  @default("human")
  actorId      String?
  actorLabel   String?
  actorAgentId String?

  /// Changed keys only — noise fields dropped.
  diff       Json?
  /// Populated only on regulated-field reads. Names only, never values.
  fieldsRead String[] @default([])
  meta       Json?

  timestamp DateTime @default(now())

  @@index([tenantId, subjectType, subjectId, timestamp])
  @@index([tenantId, actorId, timestamp])
  @@index([tenantId, timestamp])
  @@map("audit_records")
}

// ===========================================================================
// Users & sessions
// ===========================================================================

model User {
  id       String @id @default(cuid())
  tenantId String

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  email  String
  status String  @default("active") // active | invited | suspended
  branch String?

  /// Deprecated: the credential now lives on `Principal`, one per email across
  /// every tenant. Kept nullable rather than dropped because `prisma db push`
  /// cannot run code before dropping a column — a hard drop here would lose
  /// every existing install's password in the same step that removed the
  /// column to hold it. `seed/backfill.ts` moves the hash across and nulls
  /// this field; `login()` refuses a user whose `principalId` is still unset
  /// rather than falling back to it.
  passwordHash String?
  principalId  String?
  principal    Principal? @relation(fields: [principalId], references: [id])

  /// Server-side carriage. Never client-trusted.
  activeAffiliationId String?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId, personId])
  @@index([principalId])
  @@map("users")
}

/// One identity across every tenant a person touches — the group's chairman,
/// an outside shareholder in two subsidiaries, a director who is also staff at
/// the holding company. `User` stays per-tenant (a role, an affiliation, a
/// classification ceiling are all tenant-scoped facts); the credential and the
/// login itself are not, so they live here instead of being copied once per
/// tenant and drifting.
///
/// Deliberately exempt from the tenant-scope gate (`TENANT_EXEMPT_MODELS` in
/// `platform/db.ts`) — a principal is cross-tenant by definition, the same way
/// `Tenant` itself is. Its use stays confined to `lib/auth.ts`, `lib/http.ts`
/// and the seed: nowhere in a domain function is it legitimate to query a
/// Principal directly, because a domain function runs inside one tenant.
model Principal {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  status       String    @default("active") // active | suspended
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  users User[]

  @@map("principals")
}

/// Watermark-relative delta state. `reachSignature` — a hash over resolved
/// scope, policy version and consent state — lets the delta engine distinguish
/// "forty exceptions just appeared because your portfolio widened" from "forty
/// things just broke".
model AttentionWatermark {
  id       String @id @default(cuid())
  tenantId String

  userId         String
  affiliationId  String
  lastSeenAt     DateTime @default(now())
  reachSignature String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, affiliationId])
  @@map("attention_watermarks")
}

// ===========================================================================
// Pipeline as data (CRM-LEAD-001/002)
// ===========================================================================

model PipelineDefinition {
  id       String @id @default(cuid())
  tenantId String

  pipelineCode          String
  name                  String
  commercialMotion      String
  appliesToVerticals    String[] @default([])
  appliesToAccountKind  String   @default("any")
  defaultForecastMethod String   @default("weighted_stage")
  requiresAwardArtefact String   @default("none")
  isDefault             Boolean  @default(false)

  /// A tenant may additionally require manager-level grant for commit
  /// promotion above a value threshold — a configurable toggle, not a fixed rule.
  commitApprovalThreshold Decimal? @db.Decimal(18, 2)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdById   String?
  updatedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stages        PipelineStage[]
  transitions   PipelineTransition[]
  leads         Lead[]
  opportunities Opportunity[]

  @@unique([tenantId, pipelineCode])
  @@index([tenantId, effectiveFrom])
  @@map("pipeline_definitions")
}

model PipelineStage {
  id       String @id @default(cuid())
  tenantId String

  pipelineId String
  pipeline   PipelineDefinition @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  /// Immutable once referenced by a live record: a rename retires the old key
  /// and creates a new one, so historical stage_changed events stay
  /// interpretable without a rename-history join.
  stageKey String
  label    String
  sequence Int

  defaultProbability Int @default(0)
  /// One of the closed eight canonical values {0,10,20,30,40,50,60,90}.
  pipelinePosition   Int

  isOpen     Boolean @default(true)
  isTerminal Boolean @default(false)
  /// Retired post-award states: no transition may target one after cutover.
  postAward  Boolean @default(false)

  /// null means no SLA clock on this stage.
  stageAgeBudgetDays Int?
  requiredFields     String[] @default([])
  entryPredicate     Json     @default("{}")
  exitPredicate      Json     @default("{}")

  retiredAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([pipelineId, stageKey])
  @@unique([pipelineId, sequence])
  @@index([tenantId, pipelineId, pipelinePosition])
  @@map("pipeline_stages")
}

/// The permitted moves between stages — a directed graph the platform enforces,
/// not a value any caller can set.
model PipelineTransition {
  id       String @id @default(cuid())
  tenantId String

  pipelineId String
  pipeline   PipelineDefinition @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  /// null = the initial creation transition.
  fromStageKey String?
  toStageKey   String

  requiresApproval   Boolean @default(false)
  /// A grant path evaluated under the five-axis formula, never a role-slug string.
  requiredPermission String  @default("opportunities:edit")
  emitsEvent         String  @default("kz.crm.opportunity.stage_changed")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pipelineId, fromStageKey, toStageKey])
  @@index([tenantId, pipelineId])
  @@map("pipeline_transitions")
}

// ===========================================================================
// Territory & routing
// ===========================================================================

model Territory {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  name                 String
  geoAreaRef           String[] @default([]) // district list or polygon reference
  appliesToVerticals   String[] @default([])
  appliesToAccountKind String   @default("any")
  /// A position, not a named user — survives personnel change.
  ownerPositionId      String?
  ownerPartyId         String?
  capacityCeiling      Int      @default(50)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]

  @@unique([tenantId, recordCode])
  @@index([tenantId, active])
  @@map("territories")
}

model RoutingRule {
  id       String @id @default(cuid())
  tenantId String

  name     String
  active   Boolean @default(true)
  priority Int     @default(100)

  /// Six factors in declared, tenant-configurable order. Hard filters run
  /// first: assigning outside territory or grant is an authorization error,
  /// not a preference, so a candidate failing either is never scored at all.
  factorWeights        Json @default("{\"capacity\":30,\"capability\":25,\"relationship_strength\":30,\"round_robin\":15}")
  /// Round-robin breaks ties only among candidates within this margin of top score.
  tieBreakMarginPoints Int  @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active, priority])
  @@map("routing_rules")
}

/// Every routing evaluation is logged with the full candidate set considered,
/// their per-factor scores, and the winner — so a disputed assignment is fully
/// reconstructable, matching the transparency discipline applied to lead scoring.
model RoutingAudit {
  id       String @id @default(cuid())
  tenantId String

  leadId         String
  territoryId    String?
  evaluatedAt    DateTime @default(now())
  candidates     Json
  winnerPartyId  String?
  unroutedReason String?

  @@index([tenantId, leadId])
  @@map("routing_audits")
}

/// Feeds the routing engine's Capability factor. Never auto-asserted at
/// `verified` tier — an AI may propose a claim for a human to confirm.
/// Held by anyone the company knows — employees, students, candidates,
/// trainers, alumni — which is why it hangs off `partyId` and not off an
/// employment relationship.
model CapabilityClaim {
  id       String @id @default(cuid())
  tenantId String

  partyId    String
  offeringId String?
  vertical   String?
  skillId    String?
  skill      Skill?  @relation(fields: [skillId], references: [id])

  /// inferred | claimed | assessed | demonstrated | verified. The names are
  /// not the confidence order, which is why the rank is stored beside them
  /// rather than derived from enum position.
  tier                    String   @default("claimed")
  confidenceRank          Int      @default(2)
  confidenceScore         Decimal  @default(0.5) @db.Decimal(4, 3)
  claimedProficiencyLevel Int?
  /// active | contradicted | retracted | revoked | superseded
  state                   String   @default("active")
  source                  String   @default("self_report_or_cv_parse")
  /// Decay is computed from this at read time against the skill's half-life.
  lastEvidencedAt         DateTime @default(now())

  /// Free-text evidence from before the Evidence table existed; new evidence
  /// is a row, not a string.
  evidence     String?
  assertedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidenceRecords    Evidence[]
  verificationEvents VerificationEvent[]

  @@index([tenantId, partyId])
  @@index([tenantId, skillId, tier])
  @@index([tenantId, state])
  @@map("capability_claims")
}

// ===========================================================================
// Lead & Opportunity
// ===========================================================================

model Lead {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  title String

  personId       String?
  person         Person?       @relation(fields: [personId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  vertical          String
  offeringId        String?
  offering          Offering? @relation(fields: [offeringId], references: [id])
  /// Preserved verbatim, never silently discarded, through the catalog migration.
  legacyProductText String?

  pipelineId          String
  pipeline            PipelineDefinition @relation(fields: [pipelineId], references: [id])
  stageKey            String
  stageEnteredAt      DateTime           @default(now())
  legacyStage         String?
  legacyVerticalStage String?

  leadStatus String @default("open")

  /// Routing-assigned, never creator-set. `open` + null owner is the canonical
  /// `unrouted` predicate — one source of truth, not a separate boolean flag.
  ownerPartyId   String?
  territoryId    String?
  territory      Territory? @relation(fields: [territoryId], references: [id])
  unroutedReason String?
  routedAt       DateTime?

  score        Int      @default(0)
  scoreReasons String[] @default([])

  source         String   @default("manual")
  sourceDetail   String?
  estimatedValue Decimal? @db.Decimal(18, 2)
  currency       String   @default("INR")

  lastInteractionAt      DateTime?
  untouchedNotifiedAt    DateTime?
  convertedOpportunityId String?

  createdById String?
  updatedById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, leadStatus, ownerPartyId])
  @@index([tenantId, pipelineId, stageKey])
  @@index([tenantId, createdAt])
  @@map("leads")
}

model Opportunity {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  title String

  accountId              String?
  organizationId         String?
  organization           Organization? @relation(fields: [organizationId], references: [id])
  primaryContactPersonId String?
  leadId                 String?

  vertical          String
  offeringId        String?
  offering          Offering? @relation(fields: [offeringId], references: [id])
  legacyProductText String?

  pipelineId     String
  pipeline       PipelineDefinition @relation(fields: [pipelineId], references: [id])
  stageKey       String
  stageEnteredAt DateTime           @default(now())
  legacyStage    String?

  /// Second state-machine field, deliberately decoupled from stageKey: a deal
  /// can sit in negotiating for weeks without ever being confidently committable.
  forecastCategory             String    @default("pipeline")
  forecastCategoryChangedAt    DateTime?
  forecastCategoryChangeReason String?

  expectedValue     Decimal?  @db.Decimal(18, 2)
  currency          String    @default("INR")
  expectedCloseDate DateTime?

  ownerPartyId   String?
  strategicValue String?

  /// Gates the `proposed` stage transition.
  proposalId                String?
  /// Denormalised read model, event-sourced from PCT. Never written directly
  /// by CRM service code.
  proposalSentAt            DateTime?
  proposalPendingNotifiedAt DateTime?
  quoteId                   String?
  /// The won-gate reads contractId OR mouId in the service layer, never a
  /// document reference — a document's existence proves nothing about signature.
  contractId                String?
  mouId                     String?
  /// The PL-RENEWAL chain. A renewal never re-opens the original opportunity.
  parentContractId          String?

  outcome            String?
  lostReason         String?
  closedAt           DateTime?
  stageAgeNotifiedAt DateTime?

  createdById String?
  updatedById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, pipelineId, stageKey])
  @@index([tenantId, forecastCategory])
  @@index([tenantId, ownerPartyId])
  @@index([tenantId, expectedCloseDate])
  @@map("opportunities")
}

// ===========================================================================
// Commercial catalog
// ===========================================================================

model Offering {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  offeringCode            String
  name                    String
  description             String?
  vertical                String
  deliveryModel           String
  /// The field Finance reads to derive revenue recognition without a manual
  /// sales conversation per deal.
  defaultRevenueTreatment String
  status                  String   @default("draft")
  owningBusinessUnit      String?
  legacyProductStrings    String[] @default([])

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdById   String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  priceBookEntries PriceBookEntry[]
  leads            Lead[]
  opportunities    Opportunity[]

  @@unique([tenantId, offeringCode])
  @@index([tenantId, status, vertical])
  @@map("offerings")
}

/// Repricing never mutates an existing entry — it creates a new version and
/// flips the prior row to `superseded`, preserving the exact price a quote was
/// built against even after the list price moves on.
model PriceBookEntry {
  id       String @id @default(cuid())
  tenantId String

  offeringId String
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  priceBookId   String @default("standard")
  priceBookName String @default("Standard List")

  currency         String
  unitPrice        Decimal @db.Decimal(18, 2)
  billingFrequency String
  minQuantity      Int     @default(1)
  /// Required, non-nullable, deliberately set — the ceiling the discount
  /// authority gate compares against. Never defaults to 100.
  maxDiscountPct   Int

  status  String @default("active") // active | superseded
  version Int    @default(1)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  quoteLines QuoteLine[]

  @@unique([offeringId, priceBookId, version])
  @@index([tenantId, offeringId, status])
  @@index([tenantId, priceBookId, currency])
  @@map("price_book_entries")
}

// ===========================================================================
// PCT — proposals, quotes, contracts, MoU, partner agreements
// ===========================================================================

model Proposal {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  opportunityId String
  quoteId       String?
  title         String

  totalValue Decimal? @db.Decimal(18, 2)
  currency   String   @default("INR")
  documentId String?

  sentAt      DateTime?
  validUntil  DateTime?
  response    String    @default("pending")
  respondedAt DateTime?

  stalledNotifiedAt DateTime?
  ownerPartyId      String?
  createdById       String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, opportunityId])
  @@index([tenantId, response, sentAt])
  @@map("proposals")
}

model Quote {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  opportunityId String
  version       Int    @default(1)
  status        String @default("draft")

  subtotal      Decimal? @db.Decimal(18, 2)
  discountTotal Decimal? @db.Decimal(18, 2)
  grandTotal    Decimal? @db.Decimal(18, 2)
  currency      String   @default("INR")

  issuedAt   DateTime?
  validUntil DateTime?

  /// Set when AU-CRM-011 blocks issue: the whole quote blocks, never a partial
  /// issue with some lines through.
  blockedReason  String?
  approvalStepId String?

  ownerPartyId String?
  createdById  String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines QuoteLine[]

  @@unique([tenantId, recordCode])
  @@index([tenantId, opportunityId, version])
  @@map("quotes")
}

model QuoteLine {
  id       String @id @default(cuid())
  tenantId String

  quoteId String @map("quote_id")
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// A line always resolves against a specific entry AND version, never
  /// "the current price for this offering" — this is what makes a quote
  /// reproducible six months after issue.
  priceBookEntryId      String
  priceBookEntry        PriceBookEntry @relation(fields: [priceBookEntryId], references: [id])
  priceBookEntryVersion Int

  quantity       Int      @default(1)
  listUnitPrice  Decimal  @db.Decimal(18, 2)
  discountPct    Int      @default(0)
  discountAmount Decimal? @db.Decimal(18, 2)
  lineTotal      Decimal? @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@index([tenantId, quoteId])
  @@map("quote_lines")
}

/// MoU and Contract are deliberately NOT a supertype/subtype pair. They share a
/// design pattern because the underlying business facts differ: an MoU is a
/// coverage instrument that may carry zero commercial value; a contract is
/// always a priced commitment.
model Mou {
  id              String  @id @default(cuid())
  tenantId        String
  recordCode      String
  /// The pre-migration KAIZEN-YYYY-NNN value, preserved verbatim.
  legacyReference String?

  title          String
  organizationId String?
  institutionId  String?
  opportunityId  String?
  ownerPartyId   String?
  documentId     String?

  scope    String?
  vertical String?

  status String @default("proposed")

  /// May legitimately be zero — an MoU is a coverage instrument.
  commercialValue Decimal? @db.Decimal(18, 2)
  currency        String   @default("INR")
  strategicValue  String?
  termMonths      Int?

  startDate  DateTime?
  endDate    DateTime?
  signedDate DateTime?

  renewedFromId      String?
  /// Idempotency marker for the escalation ladder — the rung already notified.
  expiryNotifiedDays Int[]   @default([])

  approvedById String?
  approvedAt   DateTime?
  signedById   String?

  notes       String?
  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, status, endDate])
  @@index([tenantId, organizationId])
  @@map("mous")
}

model Contract {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  title          String
  organizationId String?
  accountId      String?
  institutionId  String?
  opportunityId  String?
  quoteId        String?
  ownerPartyId   String?
  documentId     String?

  status String @default("proposed")

  /// Required, must be > 0 — unlike MoU, an unpriced contract is a modelling error.
  commercialValue Decimal @db.Decimal(18, 2)
  currency        String  @default("INR")
  strategicValue  String?
  termMonths      Int?

  startDate  DateTime?
  endDate    DateTime?
  signedDate DateTime?

  renewedFromId      String?
  /// Wider than MoU's 90/60/30/7: a priced commitment needs longer renewal lead time.
  expiryNotifiedDays Int[]   @default([])

  terminatedAt      DateTime?
  terminationReason String?

  approvedById String?
  approvedAt   DateTime?
  signedById   String?

  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, status, endDate])
  @@index([tenantId, opportunityId])
  @@map("contracts")
}

/// Modelled deliberately on MoU's exact shape rather than invented fresh.
/// Creation is blocked without an existing or atomically-created `partner_of`
/// relationship edge. Explicitly not a commission engine.
model PartnerAgreement {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  title                 String
  partnerOrganizationId String
  relationshipId        String?
  agreementType         String
  scope                 String?
  territoryScope        String?
  /// A pointer only — commission calculation is deferred, out of scope.
  commercialTermsRef    String?

  status String @default("proposed")

  commercialValue Decimal? @db.Decimal(18, 2)
  currency        String   @default("INR")
  strategicValue  String?
  termMonths      Int?

  startDate  DateTime?
  endDate    DateTime?
  signedDate DateTime?

  renewedFromId      String?
  expiryNotifiedDays Int[]   @default([])

  ownerPartyId String?
  documentId   String?
  approvedById String?
  approvedAt   DateTime?

  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, status, endDate])
  @@index([tenantId, partnerOrganizationId])
  @@map("partner_agreements")
}

/// A structured post-mortem, mandatory above a value OR strategic threshold —
/// an OR, not an AND — capturing named competitor, real decision-maker, and
/// real lost stage, feeding Company Memory's LESSON distillation.
model WinLossReview {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  subjectType  String // opportunity | mou
  subjectId    String
  subjectLabel String?

  outcome               String
  competitorName        String?
  decisionMakerPersonId String?
  realLostStage         String?
  lostReason            String?
  lostReasonOtherText   String?
  lesson                String?

  /// Frozen at terminal-state entry: an edit to the live subject's
  /// strategic_value afterward never retroactively changes `mandatory`.
  mandatory               Boolean  @default(false)
  mandatoryBasis          String   @default("not_mandatory")
  strategicValueSnapshot  String?
  commercialValueSnapshot Decimal? @db.Decimal(18, 2)
  thresholdUsedSnapshot   Decimal? @db.Decimal(18, 2)

  completedById     String?
  completedAt       DateTime?
  dueAt             DateTime?
  overdueNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, recordCode])
  @@unique([tenantId, subjectType, subjectId])
  @@index([tenantId, mandatory, completedAt])
  @@map("win_loss_reviews")
}

// ===========================================================================
// Interaction (the universal join table)
// ===========================================================================

/// The polymorphic successor to Activity — one write, many timelines,
/// extensible past CRM's own entity types to any domain without CRM code being
/// touched again.
model Interaction {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  /// Immutable post-creation.
  interactionType String
  direction       String   @default("outbound")
  /// Immutable post-creation.
  occurredAt      DateTime

  actorPartyId        String?
  participantPartyIds String[] @default([])

  durationMinutes Int?
  subject         String?
  notes           String?
  outcome         String?

  /// An array of {contextCode, entityType, entityId} triples, minimum length 1.
  /// Replaces the seven fixed foreign keys. Each element may carry a
  /// denormalised, non-authoritative displayLabel/recordCode for render
  /// performance — never authoritative for permission decisions.
  relatedReferences Json

  /// Computed as the maximum classification across every related reference,
  /// re-evaluated at every read. Never set by the logging user. Persisted
  /// denormalised for indexing and reporting only.
  sensitivityClass String @default("internal")

  nextAction            String?
  nextActionDue         DateTime?
  attachmentDocumentIds String[]  @default([])
  messageIds            String[]  @default([])

  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, occurredAt])
  @@index([tenantId, sensitivityClass])
  @@index([tenantId, actorPartyId])
  @@map("interactions")
}

/// Each context registers the sensitivity of its own entity types. An
/// entity_type with no registration defaults to `confidential`, not `internal`,
/// and raises S1_ATTENTION — defaulting to internal means every new column
/// ships readable.
model SensitivityRegistration {
  id       String @id @default(cuid())
  tenantId String

  contextCode      String
  entityType       String
  sensitivityClass String
  registeredById   String?

  createdAt DateTime @default(now())

  @@unique([tenantId, contextCode, entityType])
  @@map("sensitivity_registrations")
}

model Task {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  title       String
  description String?
  status      String  @default("open") // open | in_progress | done | cancelled
  priority    String  @default("normal")

  assigneePartyId String?
  ownerPartyId    String?
  dueAt           DateTime?
  completedAt     DateTime?

  relatedInteractionId String?
  relatedType          String?
  relatedId            String?

  escalatedAt       DateTime?
  overdueNotifiedAt DateTime?

  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, assigneePartyId, status])
  @@index([tenantId, dueAt, status])
  @@map("tasks")
}

// ===========================================================================
// Documents
// ===========================================================================

/// File metadata only — binaries live in object storage, never in the database.
/// A re-upload creates a new row with an incremented version under the same
/// documentGroupId; it never overwrites the storage object.
model Document {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  filename   String
  storageKey String
  mimeType   String
  size       Int

  attachedToType String
  attachedToId   String

  version         Int    @default(1)
  documentGroupId String

  /// Drives per-kind signed-URL TTL, replacing the fixed 300-second constant.
  documentKind     String  @default("file_artefact")
  label            String?
  sensitivityClass String  @default("internal")

  uploadedById String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, attachedToType, attachedToId])
  @@index([tenantId, documentGroupId, version])
  @@map("documents")
}

model Note {
  id       String @id @default(cuid())
  tenantId String

  body           String
  attachedToType String
  attachedToId   String
  authorPartyId  String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, attachedToType, attachedToId])
  @@map("notes")
}

// ===========================================================================
// Equity register (eqt-owned) — equity-portal plan §5, phase 1.
//
// The register is a ledger; the cap table is its sum (§3.5). SHARE_TRANSACTION
// is append-only — a mistake is reversed with a second row carrying
// `reversalOfId`, never edited away — the same discipline TRANSACTION already
// keeps for money. EQT never holds money movement; FIN never holds share
// ownership (§3.6): an allotment for cash points at a TRANSACTION on a
// `kind: equity` category instead of posting one itself.
// ===========================================================================

/// One class of instrument this entity has issued: equity, a preference
/// series, a convertible instrument. `instrument` and `faceValue` are
/// immutable once any effective transaction references the class — changing
/// what a class of shares *is* after certificates have been printed against it
/// would make every certificate a lie about what it represents.
model ShareClass {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  name      String
  kind      String // equity | preference | debenture
  instrument String // equity | sweat_equity | ccps | ocps | rps | ccd | ocd | ncd | convertible_note | warrant | option | phantom
  faceValue Decimal @db.Decimal(18, 2)
  votesPerShare Decimal @default(1) @db.Decimal(24, 6)
  /// Liquidation preference, anti-dilution, pro-rata, board seat, information
  /// rights, dividend rate — shaped per instrument, so a free-form object
  /// rather than a column each.
  rights           Json     @default("{}")
  conversionTerms  Json?
  authorisedCount  Decimal? @db.Decimal(24, 6)
  status           String   @default("active") // active | closed

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("share_classes")
}

/// The party that holds shares: a person, an organisation, or — the
/// entity-as-stakeholder link (§3.3, s.19) — another tenant in this group,
/// recorded the way Pulley records a holding company on a subsidiary's own
/// cap table. Exactly one of `personId` / `organizationId` / `heldByTenantId`
/// is set.
model Holder {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  kind             String // person | organization | entity
  personId         String?
  organizationId   String?
  /// The holding tenant, when this holder IS another group entity. Refused at
  /// creation when that tenant has this tenant as an ancestor in its own
  /// `parentTenantId` chain (s.19: a subsidiary may not hold its holding's
  /// shares) — see `assertNotHoldingsAncestor` in `domains/equity.ts`, the one
  /// place in this domain the unscoped tenant table is read, because the check
  /// is structural on tenants rather than a read of this tenant's own data.
  heldByTenantId   String?

  /// Generator-assigned per tenant: `F-00001`.
  folioNumber String

  residency        String  @default("resident") // resident | non_resident
  /// Required when `residency` is `non_resident` — decides the FEMA calendar
  /// (repatriable: FC-GPR/FC-TRS/FLA; non_repatriable: treated as resident
  /// money under Schedule IV).
  investmentBasis  String?
  /// Regulated, like an employee's PAN — named `panNumber` rather than `pan`
  /// so it rides the same `REGULATED_EXCLUDED_FIELDS` exclusion every other
  /// statutory identifier in this platform already gets, with no change to
  /// the shared permission list.
  panNumber        String?
  nominee          Json?
  jointHolders     Json?
  status           String  @default("active") // active | ceased

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@unique([tenantId, folioNumber])
  @@index([tenantId, status])
  @@index([tenantId, personId])
  @@index([tenantId, organizationId])
  @@map("holders")
}

/// One entry in the register. Append-only: no route ever updates `count`,
/// `fromHolderId`, `toHolderId` or `shareClassId` once a row exists — a
/// mistake is rejected and re-proposed, or reversed after it goes effective
/// with a second row carrying `reversalOfId`.
model ShareTransaction {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  type String // allotment | transfer | conversion | buyback | split | bonus | forfeiture | cancellation | redemption | reduction

  shareClassId String
  fromHolderId String?
  toHolderId   String?

  count         Decimal  @db.Decimal(24, 6)
  pricePerShare Decimal? @db.Decimal(18, 2)

  /// Assigned by `makeEffective`, gaplessly per class — never caller-supplied.
  distinctiveFrom BigInt?
  distinctiveTo   BigInt?

  effectiveOn DateTime
  roundId     String?

  /// The `Transaction` (kind: equity) that already lifted cash for this
  /// allotment. Absent + a positive price ⇒ `pendingConsideration` (§3.6).
  considerationTransactionId String?
  approvalDecisionId         String?
  boardResolutionRef         String?

  status String @default("proposed") // proposed | approved | effective | reversed | rejected

  reversalOfId String?
  reversedById String?

  proposedByPartyId String

  note      String?
  documents Json    @default("[]")

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, status])
  @@index([tenantId, shareClassId, status])
  @@index([tenantId, toHolderId])
  @@index([tenantId, fromHolderId])
  @@map("share_transactions")
}

/// A printed certificate against a range of distinctive numbers. Numbered from
/// document series `C`, fixed at issue, superseded — never edited — on a
/// transfer or a split.
model ShareCertificate {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  /// The document number: `KIPL/C/26-27/001` for one this platform issued, or
  /// the paper number carried over by the opening-register import for one
  /// that pre-dates it (`imported: true`, no series `C` number allocated).
  certificateNumber String
  imported          Boolean @default(false)

  holderId     String
  shareClassId String

  distinctiveFrom BigInt
  distinctiveTo   BigInt
  count           Decimal @db.Decimal(24, 6)

  issuedOn DateTime
  status   String   @default("issued") // issued | surrendered | cancelled

  supersededById String?

  issuedForTransactionId String?

  /// Snapshotted at issue, so the document reads the same after the
  /// signatories on file change (§3.7: figures and names are snapshotted).
  signatories       Json    @default("[]")
  holderNameSnapshot String

  stampDutyPaid   Decimal?  @db.Decimal(18, 2)
  stampDutyPaidOn DateTime?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, holderId, status])
  @@index([tenantId, shareClassId])
  @@map("share_certificates")
}

/// A recorded valuation: date, valuer, basis, per-class figure — or the
/// screen says "No valuation on record" rather than inventing a number (§3.7).
model Valuation {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  asOf  DateTime
  basis String // registered_valuer | merchant_banker | ca_certificate | internal | round_price

  valuerName       String?
  perShareByClass  Json
  equityValue      Decimal? @db.Decimal(18, 2)
  reportRef        String?
  validUntil       DateTime?
  note             String?

  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, asOf])
  @@map("valuations")
}

/// A document published to holders, the board, or the secretary — a
/// certificate scan, a resolution, a valuation report, an agreement, a
/// filing. Kept apart from the general-purpose `Document` model (which
/// requires an actual stored blob) because most of what this carries in
/// phase 1 is a reference to something kept outside the platform — there is
/// no blob store yet — and `audience` is a concept specific to who may see a
/// register document, not to every attachment in the system.
model EntityDocument {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  title String
  kind  String // certificate | resolution | valuation_report | agreement | filing | other
  /// Who this is published to. A shareholder sees `shareholders` only; a
  /// director also `board`; the secretary (and chairman) every audience.
  audience String // shareholders | board | secretary

  /// A reference to where the file actually lives — an external URL, until a
  /// blob store exists. Never a claim that this platform is holding the bytes.
  fileRef String

  uploadedByPartyId String

  relatedType String?
  relatedId   String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, audience])
  @@index([tenantId, relatedType, relatedId])
  @@map("entity_documents")
}

/// A subsidiary's published summary, written into its PARENT's tenant
/// (equity-portal plan §3.3, phase 2). `tenantId` here is the parent — the
/// only place in the whole domain a write ever lands in a tenant other than
/// the one the request is running in, and only from `domains/group.ts`'s
/// `publishEntitySnapshot`, under `asSystem(parentTenantId)`. The group
/// screen reads only this row; it never opens a subsidiary's own tables.
model EntitySnapshot {
  id         String @id @default(cuid())
  /// The parent — this snapshot lives in the group's own tenant.
  tenantId   String
  recordCode String

  sourceTenantId String
  sourceSlug     String
  sourceName     String
  /// The division this entity grew out of, before it was its own tenant
  /// (`Tenant.config.originDivision`) — carried here so the structure chart
  /// can match a snapshot to the "not yet incorporated" node it replaces.
  originDivision String?

  asOf              DateTime
  /// The hash of the last `EventRecord` in the source tenant at publish
  /// time — what tells the group screen how far behind a stale snapshot is,
  /// rather than silently blending an old figure with a fresh one.
  sourceEventHash   String?

  capTable     Json // CapTableView, holders carrying heldByTenantId and holderKey
  shareClasses Json
  /// `{ available: false }` until the board module (built separately) is
  /// wired in — kept as its own JSON block so that day is one function, not
  /// a migration.
  board        Json
  financial    Json // cash, P&L by division (last complete month + FYTD), headcount, intercompany
  compliance   Json // dematStatus, isSmallCompany, certificateOverdueCount, kind
  valuation    Json?

  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, sourceTenantId])
  @@unique([tenantId, recordCode])
  @@index([tenantId, asOf])
  @@map("entity_snapshots")
}

/// Every version an `EntitySnapshot` has ever held — the audit of what the
/// group saw and when, kept even after a fresher snapshot overwrites the
/// live row. Written in the same call that upserts `EntitySnapshot`.
model EntitySnapshotHistory {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  sourceTenantId  String
  sourceSlug      String
  sourceName      String
  originDivision  String?
  asOf            DateTime
  sourceEventHash String?
  capTable        Json
  shareClasses    Json
  board           Json
  financial       Json
  compliance      Json
  valuation       Json?
  publishedAt     DateTime

  createdAt DateTime @default(now())

  @@index([tenantId, sourceTenantId, publishedAt])
  @@map("entity_snapshot_history")
}

// ===========================================================================
// Finance (fin-owned)
// ===========================================================================

model Invoice {
  id       String @id @default(cuid())
  tenantId String

  /// The tax invoice number, allocated when the invoice is issued and not before.
  ///
  /// A tax invoice series has to be consecutive: the return reports the range
  /// issued and the count cancelled within it, and a number that was allocated
  /// to a draft somebody abandoned is a gap nothing explains. So a draft carries
  /// none, and gets one at the moment it becomes a document.
  ///
  /// This is the one record code in the platform that is not allocated at
  /// creation, and the reason is that a draft is not the record the code names.
  /// Everything else about it holds: generator-assigned, never caller-supplied,
  /// immutable once set.
  recordCode String?

  /// What to call a draft.
  ///
  /// From its own series, so it is obvious on sight that `DRF-2026-00004` is not
  /// an invoice number and cannot be quoted to a customer as one. Kept after the
  /// invoice is issued, so "which draft became INV-2026-00019" stays answerable.
  draftReference String?

  accountId      String?
  organizationId String?
  contractId     String?
  opportunityId  String?

  status     String    @default("draft")
  currency   String    @default("INR")
  issuedDate DateTime?
  dueDate    DateTime?

  /// Regulated — structurally excluded from CRM's receivables projection
  /// entirely, not merely nulled at render time.
  taxRegistrationReference String?

  /// GST. The place of supply decides whether the tax splits into CGST+SGST
  /// (within the state) or lands as a single IGST (across a state line), so it
  /// is stored rather than inferred at render time — the invoice was raised
  /// under one reading of it and reprinting must not silently change the tax.
  placeOfSupply String?
  interState    Boolean @default(false)
  customerGstin String?
  taxableValue  Decimal @default(0) @db.Decimal(18, 2)
  cgstAmount    Decimal @default(0) @db.Decimal(18, 2)
  sgstAmount    Decimal @default(0) @db.Decimal(18, 2)
  igstAmount    Decimal @default(0) @db.Decimal(18, 2)
  roundOff      Decimal @default(0) @db.Decimal(8, 2)
  grandTotal    Decimal @default(0) @db.Decimal(18, 2)
  /// Which division earns the revenue on this invoice.
  division      String?

  /// An individual customer. The education motion bills people at least as
  /// often as it bills companies — somebody who walks in and pays for a course
  /// is not an organisation, and forcing one into existence to raise their
  /// invoice put a fake company in the accounts list every time.
  personId String?

  /// What the document said about payment at the moment it was handed over.
  ///
  /// `full` — the whole invoice was settled at issue.
  /// `part` — an instalment was taken at issue and a balance remained.
  /// `credit` — nothing was collected at issue; payable by the due date.
  ///
  /// Fixed at issue and never restated. A tax invoice is a final document: the
  /// copy the customer holds must still read the same in three years, so a
  /// payment that arrives next week does not rewrite it. Later instalments are
  /// receipts, which are their own documents — that is what RECEIPT is for, and
  /// `status` continues to follow from the receipts actually allocated.
  paymentType String @default("credit")

  /// The second figure the invoice prints: the total payable, and the amount
  /// payable now. On a full payment they are the same number and it is still
  /// printed twice, because a customer reading an invoice should not have to
  /// work out which of the two they are looking at. Fixed at issue, like the
  /// declaration above.
  amountPayableNow Decimal @default(0) @db.Decimal(18, 2)

  /// How the money changed hands at issue, and the reference it left behind.
  /// Printed, because "paid by UPI, ref 402…" is what makes the invoice also
  /// the customer's proof of what they handed over on the day.
  paymentMode      String?
  paymentReference String?

  /// Free text printed under the lines — what the invoice is for in the
  /// customer's own words, delivery notes, anything the lines cannot say.
  notes String?

  /// The return this invoice's tax was reported in. Set when a GSTR-1 is filed,
  /// and what makes a filed period refuse further edits.
  gstFilingId String?

  overdueNotifiedAt DateTime?
  createdById       String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  lines         InvoiceLine[]
  receipts      Receipt[]
  finalInvoices FinalInvoice[]

  @@unique([tenantId, recordCode])
  @@unique([tenantId, draftReference])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, accountId])
  @@index([tenantId, personId])
  @@index([tenantId, createdById])
  @@index([tenantId, gstFilingId])
  @@map("invoices")
}

model InvoiceLine {
  id       String @id @default(cuid())
  tenantId String

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  offeringId    String?
  /// The course being billed, where this line is education revenue. What a
  /// course costs, the tax it attracts and the SAC it is classified under are
  /// facts about the course, so an employee raising the invoice picks the
  /// course and does not have to know any of them.
  courseId      String?
  /// The student's place on that course.
  ///
  /// The line already names the course and the invoice already names the
  /// person; this is the two of them together, which is the thing actually
  /// being billed. Without it, a student on two courses has two enrolments and
  /// two fee invoices that can only be matched up by reading the descriptions —
  /// and "has this enrolment been paid for" has no answer at all.
  ///
  /// Checked on the way in: the enrolment has to belong to the person the
  /// invoice is addressed to, and to the course the line names.
  enrollmentId  String?
  description   String
  quantity      Int     @default(1)
  /// The price of one of whatever this line is, before any discount.
  unitPrice Decimal @default(0) @db.Decimal(18, 2)
  /// The extended value after the line's own discount — unitPrice x quantity,
  /// less `discountAmount`. This is the taxable value: what GST is computed
  /// on, and what the invoice actually bills for this line. The pre-discount
  /// figure (`unitPrice x quantity`) is never stored separately because it is
  /// always recoverable from those two columns; a course fee before a
  /// discount is a derived fact, not a second source of truth to keep in step.
  amount Decimal @db.Decimal(18, 2)
  /// The discount on this line, entered directly in rupees or derived from
  /// `discountPercent` against `unitPrice x quantity` — whichever the counter
  /// typed, the other is back-computed so the two never disagree.
  discountAmount  Decimal @default(0) @db.Decimal(18, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  /// The order the lines were entered in, so an edited invoice does not
  /// reshuffle itself on reload.
  position Int @default(0)
  /// Derived from OFFERING.defaultRevenueTreatment — never asked of sales per deal.
  revenueMethod String

  /// GST per line, because a single invoice can carry goods and services at
  /// different rates and a single invoice-level rate would misstate both.
  hsnSac    String?
  gstRate   Decimal @default(0) @db.Decimal(5, 2)
  taxAmount Decimal @default(0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@index([tenantId, invoiceId])
  @@index([tenantId, enrollmentId])
  @@index([tenantId, courseId])
  @@map("invoice_lines")
}

/// The parallel obligation entity for the education motion — a sibling
/// structure to Invoice, not a variant of it.
model FeeInstalment {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  enrollmentId String
  feePlanId    String?
  amount       Decimal  @db.Decimal(18, 2)
  currency     String   @default("INR")
  dueDate      DateTime
  status       String   @default("scheduled")

  overdueNotifiedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  receipts Receipt[]

  @@unique([tenantId, recordCode])
  @@index([tenantId, status, dueDate])
  @@map("fee_instalments")
}

/// The money-movement fact — append-only, gateway-authoritative, idempotent on
/// gatewayReference. Never updated in place; corrections are new rows. May
/// exist before its resolving obligation is even issued.
model Payment {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  amount           Decimal  @db.Decimal(18, 2)
  currency         String   @default("INR")
  gatewayReference String
  receivedAt       DateTime
  status           String   @default("received")
  method           String   @default("bank_transfer")

  /// Regulated — never included in CRM's receivables projection at all.
  bankAccountReference String?

  payerOrganizationId String?
  payerPersonId       String?
  reversalOfPaymentId String?
  note                String?

  /// Who took the money.
  ///
  /// A gateway webhook has no human behind it and leaves this null; a hundred
  /// rupees handed across a counter does, and "who collected this" is both the
  /// first question asked when a receipt is disputed and the narrowing that lets
  /// an employee hold `payments@own` without seeing the company's collections.
  recordedById String?

  /// The idempotency marker CRM-FIN-001 adds so the overdue-notification job
  /// stops re-notifying the same pending payment on every hourly tick.
  pendingLastNotifiedAt DateTime?

  createdAt DateTime @default(now())

  receipts Receipt[]

  @@unique([tenantId, gatewayReference])
  @@unique([tenantId, recordCode])
  @@index([tenantId, receivedAt])
  @@index([tenantId, status])
  @@index([tenantId, recordedById])
  @@map("payments")
}

/// The allocation join — many-to-many between Payment and
/// Invoice/FeeInstalment. Only the sum of a subject's allocated amounts
/// determines what has actually been paid against it. This is what finally
/// makes partial payments and credit notes representable.
model Receipt {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  invoiceId       String?
  invoice         Invoice?       @relation(fields: [invoiceId], references: [id])
  feeInstalmentId String?
  feeInstalment   FeeInstalment? @relation(fields: [feeInstalmentId], references: [id])

  allocatedAmount Decimal  @db.Decimal(18, 2)
  allocatedAt     DateTime @default(now())
  allocatedById   String?

  /// The position of this allocation against its subject, as it stood when the
  /// receipt was written.
  ///
  /// A receipt is the document a part payment produces, and it is the document
  /// that has to carry the two figures: what the invoice is for, and what is
  /// being handed over now. Both are snapshotted rather than recomputed,
  /// because a receipt is a receipt — the piece of paper saying "₹20,000 of
  /// ₹70,800, ₹50,800 still owed" must keep saying that after the next
  /// instalment lands.
  subjectTotal     Decimal @default(0) @db.Decimal(18, 2)
  balanceAfter     Decimal @default(0) @db.Decimal(18, 2)
  /// How this instalment was paid. Copied from the payment so a reprint does
  /// not depend on the payment row still reading the same way.
  paymentMode      String?
  paymentReference String?
  note             String?

  /// The number this receipt was issued under before it reached this platform —
  /// `KIPL/R/2026-27/002` and the like.
  ///
  /// `recordCode` is generator-assigned and immutable, which is right: a
  /// gapless per-tenant series is the point of it. But a receipt the customer
  /// is already holding has a number on it, and "find me the receipt for that
  /// twenty thousand" is asked with that number and no other. So it is carried
  /// rather than overwritten, the same way an enrolment carries the
  /// certificate reference it arrived with.
  legacyReference String?

  createdAt DateTime @default(now())

  @@unique([tenantId, recordCode])
  @@index([tenantId, paymentId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, allocatedAt])
  @@index([tenantId, legacyReference])
  @@map("receipts")
}

/// The document raised once the instalments are done.
///
/// A tax invoice is final: it is raised once, states the whole obligation, and
/// must still read the same in three years. Each instalment against it is a
/// receipt, which is its own numbered document. Neither of those, on its own,
/// answers the question a customer asks at the end — "what did I owe, what have
/// I paid, and against which receipts" — because the invoice predates the
/// payments and each receipt only knows about itself.
///
/// So this is that answer, raised deliberately by whoever is at the counter
/// rather than rendered on the fly: it has its own number and its own date, it
/// names every receipt it consolidates, and the figures are snapshotted, because
/// a document handed to a customer cannot restate itself the next time it is
/// opened.
///
/// Raising a second one after a further instalment supersedes the first rather
/// than replacing it. Both were true when they were handed over.
model FinalInvoice {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  issuedAt   DateTime @default(now())
  issuedById String?

  /// The figures as they stood when it was raised.
  totalPayable  Decimal @default(0) @db.Decimal(18, 2)
  totalReceived Decimal @default(0) @db.Decimal(18, 2)
  creditNoted   Decimal @default(0) @db.Decimal(18, 2)
  balance       Decimal @default(0) @db.Decimal(18, 2)
  /// True when nothing was left owing at the moment it was raised.
  settled       Boolean @default(false)

  /// The receipt numbers it consolidates, in the order they were issued. Held
  /// as codes as well as in the snapshot because "which receipts does this
  /// cover" is asked of the row itself, from a list, without opening the JSON.
  receiptCodes String[] @default([])
  receiptCount Int      @default(0)

  /// Every receipt row as it stood: number, date, amount, mode, reference. A
  /// reprint reads this rather than the live receipts, so a later instalment
  /// cannot change what an already-issued statement says.
  snapshot Json

  /// The later statement that replaced this one.
  supersededById String?
  status         String  @default("issued") // issued | superseded
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, invoiceId, status])
  @@map("final_invoices")
}

/// The only permitted correction to an issued invoice line — an
/// obligation-reducing fact, structurally distinct from a payment-side reversal
/// so the two are never re-conflated the way a `refunded` status conflated them.
model CreditNote {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  invoiceId  String
  amount     Decimal  @db.Decimal(18, 2)
  currency   String   @default("INR")
  reason     String
  issuedAt   DateTime @default(now())
  issuedById String?

  createdAt DateTime @default(now())

  @@unique([tenantId, recordCode])
  @@index([tenantId, invoiceId])
  @@map("credit_notes")
}

/// A GST return, prepared and then filed.
///
/// Two facts make this a record rather than a report. The first is that a
/// return is a snapshot: what was filed on the 11th is what was filed, and a
/// back-dated invoice must not silently restate it — so the figures are stored
/// as they stood, beside the query that produced them. The second is that
/// filing closes the period: once GSTR-1 for August is filed, an August invoice
/// cannot be edited, and the thing that knows that is this row.
///
/// `arn` is the portal's acknowledgement. A return with no ARN was prepared and
/// not filed, whatever anybody remembers about it.
model GstFiling {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  /// GSTR1 — outward supplies. GSTR3B — the monthly summary and the payment.
  returnType String
  /// The tax period, `YYYY-MM`.
  period     String
  /// The registration it is filed under, copied from the company profile at
  /// preparation, because a company that changes registration must not have its
  /// history reattributed.
  gstin      String?

  /// prepared | filed | superseded
  status String @default("prepared")

  /// The whole computed return as it stood when prepared: sections, invoice
  /// references, HSN summary. Stored so a filed return can be re-read and
  /// re-exported without recomputing it from books that have moved on.
  snapshot Json

  taxableValue   Decimal @default(0) @db.Decimal(18, 2)
  cgstAmount     Decimal @default(0) @db.Decimal(18, 2)
  sgstAmount     Decimal @default(0) @db.Decimal(18, 2)
  igstAmount     Decimal @default(0) @db.Decimal(18, 2)
  /// GSTR-3B only: the credit claimed on inward supplies, and what is left to
  /// pay in cash after it.
  inputTaxCredit Decimal @default(0) @db.Decimal(18, 2)
  netPayable     Decimal @default(0) @db.Decimal(18, 2)

  invoiceCount Int @default(0)

  preparedById   String?
  preparedAt     DateTime  @default(now())
  arn            String?
  filedAt        DateTime?
  filedById      String?
  /// The later preparation that replaced this one, where a prepared return was
  /// recomputed before filing. Prepared returns are superseded rather than
  /// deleted, so "what did we think the liability was last week" stays
  /// answerable.
  supersededById String?
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, returnType, period, status])
  @@index([tenantId, period])
  @@map("gst_filings")
}

/// A lightweight, disposable receivables summary per account/opportunity,
/// hydrated from Finance's event payloads. Explicitly non-authoritative — safe
/// to rebuild, discard or re-hydrate at any time, since CRM holds no
/// authoritative money state post-migration.
model ReceivablesProjection {
  id       String @id @default(cuid())
  tenantId String

  subjectType  String
  subjectId    String
  subjectLabel String?

  amountOutstanding Decimal?  @db.Decimal(18, 2)
  currency          String    @default("INR")
  nextDueDate       DateTime?
  dunningStage      String?

  hydratedAt DateTime @default(now())

  @@unique([tenantId, subjectType, subjectId])
  @@index([tenantId, dunningStage])
  @@map("receivables_projections")
}

// ===========================================================================
// Education (edu)
// ===========================================================================

model Course {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  name          String
  code          String
  description   String?
  durationWeeks Int?
  offeringId    String?
  active        Boolean @default(true)

  /// What the course sells for before tax, the tax it attracts, and the SAC it
  /// is classified under. Held on the course because whoever is raising the
  /// invoice — increasingly an employee at a counter rather than the finance
  /// head — should not have to know the price list or the tax code.
  feeAmount Decimal? @db.Decimal(18, 2)
  gstRate   Decimal  @default(18) @db.Decimal(5, 2)
  hsnSac    String?
  /// Which division earns what this course brings in.
  division  String   @default("education")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cohorts Cohort[]

  @@unique([tenantId, recordCode])
  @@unique([tenantId, code])
  @@map("courses")
}

model Cohort {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  name           String
  startDate      DateTime
  endDate        DateTime?
  trainerPartyId String?
  institutionId  String?
  capacity       Int       @default(30)
  status         String    @default("planned")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]

  @@unique([tenantId, recordCode])
  @@index([tenantId, trainerPartyId])
  @@map("cohorts")
}

model Enrollment {
  id              String  @id @default(cuid())
  tenantId        String
  recordCode      String
  legacyReference String?

  personId String
  cohortId String
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  /// The college this student came from, where they came from one.
  ///
  /// The whole reason the platform models colleges separately from client
  /// companies is that students are recruited out of them — so "how many did
  /// this college send us, and how did they do" is the question the
  /// relationship exists to answer. Without this edge it was unanswerable, and
  /// an institution profile was a record with nothing hanging off it.
  ///
  /// Nullable on purpose: somebody who walks in and pays for a course has no
  /// college, and requiring one would mean inventing it.
  institutionId String?
  institution   Organization? @relation("EnrollmentInstitution", fields: [institutionId], references: [id])

  opportunityId String?

  status           String    @default("reserved")
  enrolledAt       DateTime?
  completedAt      DateTime?
  progressPct      Int       @default(0)
  attendancePct    Int       @default(100)
  atRisk           Boolean   @default(false)
  atRiskNotifiedAt DateTime?

  /// Regulated (DPDP-covered) — read-audited, never masked-but-present.
  guardianName  String?
  guardianPhone String?
  guardianEmail String?
  isMinor       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance    Attendance[]
  dailyProgress DailyProgress[]
  logs          LearnerLog[]

  @@unique([tenantId, recordCode])
  @@index([tenantId, cohortId, status])
  @@index([tenantId, personId])
  @@index([tenantId, institutionId])
  @@map("enrollments")
}

/// An explicit collection name is set on all three education operational models
/// as defence-in-depth, so a future model rename can never silently change the
/// live collection out from under a migration.
model Attendance {
  id       String @id @default(cuid())
  tenantId String

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  sessionDate  DateTime
  status       String
  recordedById String?
  note         String?

  createdAt DateTime @default(now())

  @@unique([enrollmentId, sessionDate])
  @@index([tenantId, sessionDate])
  @@map("attendances")
}

model DailyProgress {
  id       String @id @default(cuid())
  tenantId String

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  progressDate DateTime
  score        Int?
  note         String?
  recordedById String?

  createdAt DateTime @default(now())

  @@index([tenantId, enrollmentId, progressDate])
  @@map("daily_progresses")
}

/// Everything else that happens to a student on a day.
///
/// Attendance says whether they turned up and daily progress says how they did.
/// Neither can hold the question they asked, the complaint they made or the
/// praise they gave, and those were being lost — which is the same as saying
/// nobody could answer "what has gone on with this student" from the system.
///
/// Four kinds, deliberately not one free-text note field: a question that is
/// still unanswered and a problem that is still open are work, and work has to
/// be countable. A note is the fallback for everything that is neither.
model LearnerLog {
  id       String @id @default(cuid())
  tenantId String

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  /// The day it happened, which is not always the day it was typed in.
  entryDate DateTime

  /// query | feedback | issue | note
  kind   String
  title  String
  detail String?

  /// low | medium | high — on a query or an issue, how much it matters.
  severity String?
  /// Feedback carries a 1-5 rating where somebody gave one.
  rating   Int?

  /// open | in_progress | resolved. A note and a piece of feedback are closed
  /// the moment they are recorded; a query and an issue are not.
  status         String    @default("open")
  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?

  recordedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, enrollmentId, entryDate])
  @@index([tenantId, kind, status])
  @@map("learner_logs")
}

// ===========================================================================
// Projects (prj) — the record a project manager actually needs, post-award
// ===========================================================================

model Project {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  name           String
  organizationId String?
  opportunityId  String?
  contractId     String?
  managerPartyId String?

  status              String    @default("planned") // planned | active | on_hold | delivered | closed
  startDate           DateTime?
  targetEndDate       DateTime?
  actualEndDate       DateTime?
  healthBand          String    @default("stable")
  scheduleVariancePct Int       @default(0)

  /// Set when a won-opportunity handoff has not yet been accepted (EX-CRM-012).
  handoffAcceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, status])
  @@map("projects")
}

// ===========================================================================
// Exception engine (xcp) & notifications
// ===========================================================================

/// A record in an actionable bad state. An accountable owner is always resolved
/// BEFORE any notification fires. Escalation is bounded to exactly four named
/// triggers.
model ExceptionRecord {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  code     String
  label    String
  severity String
  state    String @default("open")

  subjectType  String
  subjectId    String
  subjectLabel String?
  domain       String  @default("crm")
  detail       String?
  reasonCode   String?

  ownerPartyId          String?
  accountablePositionId String?
  /// Set when the routing engine failed to resolve an owner — itself a
  /// first-class, measured category feeding H_OPS, never a blank assignee.
  ownerUnresolved       Boolean @default(false)

  raisedAt         DateTime  @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById String?
  resolvedAt       DateTime?
  resolvedById     String?
  resolutionNote   String?

  slaDueAt           DateTime?
  escalatedAt        DateTime?
  escalationRung     Int       @default(0)
  escalationTrigger  String?
  escalatedToPartyId String?

  /// (automationVersionId, subjectRef, triggerFingerprint, ladderRung)
  triggerFingerprint String?
  ladderRung         Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, state, severity, raisedAt])
  @@index([tenantId, ownerPartyId, state])
  @@index([tenantId, subjectType, subjectId])
  @@map("exception_records")
}

model Notification {
  id       String @id @default(cuid())
  tenantId String

  recipientPartyId String
  priority         String  @default("N2_NORMAL")
  channel          String  @default("in_app")
  title            String
  body             String
  severity         String?

  subjectType String?
  subjectId   String?
  drillPath   String?

  readAt       DateTime?
  dispatchedAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId, recipientPartyId, readAt])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

// ===========================================================================
// P5 — Automation substrate
// ===========================================================================

model AutomationDefinition {
  id       String @id @default(cuid())
  tenantId String

  jobName               String
  label                 String
  automationClass       String
  cronExpression        String  @default("0 * * * *")
  enabled               Boolean @default(true)
  /// In-flight firings keep their original definition version; new firings pick
  /// up the new one. No in-flight migration.
  version               Int     @default(1)
  accountablePositionId String?
  config                Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs JobRun[]

  @@unique([tenantId, jobName])
  @@map("automation_definitions")
}

model JobRun {
  id       String @id @default(cuid())
  tenantId String

  definitionId        String
  definition          AutomationDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  automationVersionId String

  jobName           String
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  status            String    @default("running") // running | completed | failed
  processed         Int       @default(0)
  notified          Int       @default(0)
  skippedIdempotent Int       @default(0)
  errors            String[]  @default([])
  dryRun            Boolean   @default(false)

  @@index([tenantId, jobName, startedAt])
  @@map("job_runs")
}

/// A firing with an already-recorded idempotency key does not re-execute. This
/// is a substrate-level guard IN ADDITION to each job's own per-record marker
/// fields, not a replacement for them.
model JobFiringLog {
  id       String @id @default(cuid())
  tenantId String

  automationVersionId String
  subjectRef          String
  triggerFingerprint  String
  ladderRung          Int    @default(0)

  jobRunId String?
  firedAt  DateTime @default(now())
  outcome  String   @default("executed") // executed | skipped | failed

  @@unique([automationVersionId, subjectRef, triggerFingerprint, ladderRung])
  @@index([tenantId, firedAt])
  @@map("job_firing_logs")
}

// ===========================================================================
// P6 — Agent principals
// ===========================================================================

/// Every agent carries its own identity — never a shared service account, never
/// a role — and acts only through declared TOOLs.
model AgentPrincipal {
  id       String @id @default(cuid())
  tenantId String

  agentKey      String
  name          String
  purpose       String
  /// The agent's ceiling tier. An individual action may classify lower but
  /// never higher.
  tier          String
  declaredTools String[] @default([])
  status        String   @default("active") // active | paused | revoked

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actions AgentAction[]

  @@unique([tenantId, agentKey])
  @@map("agent_principals")
}

model AgentAction {
  id       String @id @default(cuid())
  tenantId String

  agentId String
  agent   AgentPrincipal @relation(fields: [agentId], references: [id], onDelete: Cascade)

  tool   String
  action String
  tier   String

  subjectType String
  subjectId   String
  proposal    Json
  rationale   String

  state         String  @default("proposed") // proposed | accepted | rejected | executed | blocked
  blockedReason String?

  /// When acting for a person, the agent carries this rather than assuming a role.
  onBehalfOfPartyId String?
  humanActorId      String?
  decidedAt         DateTime?

  proposedAt DateTime @default(now())

  @@index([tenantId, agentId, proposedAt])
  @@index([tenantId, state])
  @@map("agent_actions")
}

// ===========================================================================
// Analytics, health, memory
// ===========================================================================

model KpiReading {
  id       String @id @default(cuid())
  tenantId String

  domainCode String
  metric     String
  dimensions Json     @default("{}")
  value      Float
  target     Float?
  asOf       DateTime
  computedAt DateTime @default(now())

  @@index([tenantId, domainCode, metric, asOf])
  @@map("kpi_readings")
}

model HealthScore {
  id       String @id @default(cuid())
  tenantId String

  domainCode      String
  asOf            DateTime
  score           Float?
  band            String?
  /// {factor, weight, value, target, factorScore, contribution, quarantined}
  factors         Json     @default("[]")
  /// A domain with insufficient inputs renders "not yet measured", never a zero.
  state           String   @default("measured")
  policyVersionId String?

  computedAt DateTime @default(now())

  @@unique([tenantId, domainCode, asOf])
  @@index([tenantId, domainCode, asOf])
  @@map("health_scores")
}

/// The flat (date, metric, dimensions, value) upsert model — a deliberately
/// minimal design preserved as-is. `pipeline_value`/`pipeline_count` stop being
/// written; historical rows are retained, never deleted, as a point-in-time
/// record of the old formula.
model DailyMetric {
  id       String @id @default(cuid())
  tenantId String

  date       DateTime
  metric     String
  dimensions Json     @default("{}")
  value      Float
  computedAt DateTime @default(now())

  /// Set on the two retired metrics so a reader knows the formula was defective.
  retired Boolean @default(false)

  @@index([tenantId, date, metric])
  @@map("daily_metrics")
}

/// P8 — a lesson distilled from a win/loss review or a decision review.
model Lesson {
  id       String @id @default(cuid())
  tenantId String

  sourceType String
  sourceId   String
  title      String
  body       String
  domain     String   @default("crm")
  tags       String[] @default([])

  createdById String?
  createdAt   DateTime @default(now())

  @@index([tenantId, domain, createdAt])
  @@map("lessons")
}

/// P8 — the AI-authored prose the Command Center leads with past the narrative
/// window. Every claim resolves to an admitted delta item.
model Narrative {
  id       String @id @default(cuid())
  tenantId String

  forUserId          String
  windowFrom         DateTime
  windowTo           DateTime
  reconciliationLine String
  body               String
  /// The delta item ids every claim resolves to.
  claimRefs          String[] @default([])

  createdAt DateTime @default(now())

  @@index([tenantId, forUserId, createdAt])
  @@map("narratives")
}

// ===========================================================================
// P9 — Surface composition
// ===========================================================================

model SurfaceTemplate {
  id       String @id @default(cuid())
  tenantId String

  templateKey   String
  name          String
  archetype     String
  eligibleRoles String[] @default([])
  navGroup      String   @default("main")
  version       Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bindings WidgetBinding[]

  @@unique([tenantId, templateKey])
  @@map("surface_templates")
}

/// Seven mandatory declarations on every widget: data source, permission,
/// severity relevance, actions, drill target, mobile behaviour, empty state.
/// A non-empty actions[] is enforced at publish time — no dead metrics.
model WidgetDefinition {
  id       String @id @default(cuid())
  tenantId String

  widgetKey          String
  title              String
  dataSource         String
  requiredPermission String
  severityRelevance  String  @default("S0_INFO")
  actions            Json    @default("[]")
  drillTarget        String
  mobileBehaviour    String  @default("keep") // keep | drill_only | shed
  emptyState         String
  /// A routing target for an item nobody can act on, with an SLA — never omission.
  noActionFallback   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bindings WidgetBinding[]

  @@unique([tenantId, widgetKey])
  @@map("widget_definitions")
}

model WidgetBinding {
  id       String @id @default(cuid())
  tenantId String

  templateId String
  template   SurfaceTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  widgetId   String
  widget     WidgetDefinition @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  position              Int    @default(0)
  /// movable | removable | locked
  personalisationPolicy String @default("movable")
  config                Json   @default("{}")

  createdAt DateTime @default(now())

  @@unique([templateId, widgetId])
  @@index([tenantId, templateId, position])
  @@map("widget_bindings")
}

/// Unreachable nodes are unrendered, never merely disabled. Badge counts obey
/// the same five-axis filter as content — a badge number is never a permission leak.
model NavNode {
  id       String @id @default(cuid())
  tenantId String

  nodeKey            String
  label              String
  icon               String   @default("circle")
  path               String
  group              String   @default("main")
  parentKey          String?
  position           Int      @default(0)
  requiredPermission String?
  eligibleArchetypes String[] @default([])
  searchSynonyms     String[] @default([])

  createdAt DateTime @default(now())

  @@unique([tenantId, nodeKey])
  @@index([tenantId, group, position])
  @@map("nav_nodes")
}

/// Persisted so an auditor's "why wasn't X on his screen on 14 March" is
/// answerable without re-derivation. `withheld[]` uses the closed reason-code set.
model SurfaceComposition {
  id       String @id @default(cuid())
  tenantId String

  userId          String
  affiliationId   String
  templateKey     String
  templateVersion Int
  policyVersionId String?

  widgets  Json @default("[]")
  withheld Json @default("[]")

  composedAt DateTime @default(now())

  @@index([tenantId, userId, composedAt])
  @@map("surface_compositions")
}

/// Tunable without a code change — every constant the corpus flags as
/// unvalidated ships as a row here from day one.
model Threshold {
  id       String @id @default(cuid())
  tenantId String

  thresholdKey String
  value        Float
  unit         String  @default("count")
  description  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, thresholdKey])
  @@map("thresholds")
}

// ===========================================================================
// People (bounded context `hr`, plane P2) — Canon §14.
//
// The standalone HRM build carried its own stub PERSON, AFFILIATION,
// ORGANIZATION_UNIT and POSITION because it had no identity plane to read
// from. Here it does: PERSON and AFFILIATION above are the real ones, so the
// stubs are gone and an EMPLOYMENT_RELATIONSHIP points at the same Person row
// a lead, a student or a contact points at. That is the merge — one human,
// one record, however many relationships they hold with the company.
//
// Everything below carries `tenantId` and, where a human refers to it out
// loud, a generator-assigned `recordCode`.
// ===========================================================================

/// Internal org structure. Distinct from `Organization`, which is a company we
/// deal with — this is a unit inside our own.
model OrgUnit {
  id       String @id @default(cuid())
  tenantId String

  name     String
  unitType String    @default("team") // company | division | department | team
  /// Which of the three divisions this unit's cost and revenue land in.
  division String? // software | skill | education | shared
  parentId String?
  parent   OrgUnit?  @relation("OrgUnitTree", fields: [parentId], references: [id])
  children OrgUnit[] @relation("OrgUnitTree")

  headPositionId String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  positions Position[]

  @@index([tenantId, parentId])
  @@map("org_units")
}

/// The role shape, independent of who holds it or where it sits.
model Job {
  id       String @id @default(cuid())
  tenantId String

  title     String
  jobFamily String
  jobLevel  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  positions Position[]

  @@index([tenantId, jobFamily])
  @@map("jobs")
}

/// A seat. Owned by the org context; HR consumes it. Its lead flag is an
/// attribute of the seat, never an access role — reporting lines and
/// permissions are decided separately and by different people.
model Position {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  orgUnitId String
  orgUnit   OrgUnit @relation(fields: [orgUnitId], references: [id])
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id])

  location            String  @default("Head Office")
  reportingPositionId String?
  isLeadPosition      Boolean @default(false)
  status              String  @default("Requested") // R1
  budgetLineId        String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  requisitions Requisition[]
  assignments  Assignment[]

  @@unique([tenantId, recordCode])
  @@index([tenantId, status])
  @@index([tenantId, orgUnitId])
  @@map("positions")
}

/// The employment spine. One row per employment of one person by one legal
/// entity; a rehire is a second row, not an edit of the first.
model EmploymentRelationship {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  personId String
  person   Person @relation(fields: [personId], references: [id])

  legalEntity            String    @default("Kaizen Infinities Pvt Ltd")
  hireEffectiveDate      DateTime
  status                 String    @default("PendingHire") // Diagram 14.1
  confirmationState      String    @default("not_applicable")
  separationType         String?
  separationDate         DateTime?
  noticePeriodDays       Int       @default(30)
  /// Null until a separation is recorded — "we have not decided" is a
  /// different fact from "no".
  rehireEligible         Boolean?
  rehireIneligibleReason String?

  /// Statutory identifiers, classified `regulated` and structurally excluded
  /// from projections rather than masked.
  panNumber        String?
  aadhaarReference String?
  uanNumber        String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  assignments         Assignment[]
  compensationRecords CompensationRecord[]
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  workAttendances     WorkAttendance[]
  goals               Goal[]
  performanceEvidence PerformanceEvidence[]
  learningRecords     LearningRecord[]
  payrollInstructions PayrollInstruction[]
  onboarding          Onboarding?
  offboarding         Offboarding?

  @@unique([tenantId, recordCode])
  @@index([tenantId, status])
  @@index([tenantId, personId])
  @@map("employment_relationships")
}

model Requisition {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  positionId String
  position   Position @relation(fields: [positionId], references: [id])

  budgetLineId    String?
  raisedByPartyId String?
  targetStartDate DateTime?
  status          String    @default("Draft") // R5

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  applications Application[]

  @@unique([tenantId, recordCode])
  @@index([tenantId, status])
  @@map("requisitions")
}

model Application {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  requisitionId    String
  requisition      Requisition @relation(fields: [requisitionId], references: [id])
  /// The candidate is a Person from the identity plane — the same row they
  /// keep if they are hired, so a hire is a new affiliation, not a new human.
  candidatePartyId String
  candidate        Person      @relation("ApplicationCandidate", fields: [candidatePartyId], references: [id])

  status           String  @default("Applied") // R3
  rejectionReason  String?
  screeningOutcome String?
  assessmentState  String?
  holdFlag         Boolean @default(false)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, status])
  @@index([tenantId, requisitionId])
  @@map("applications")
}

/// Where somebody sits, effective-dated. `requestStatus` is the change
/// request's lifecycle (R4); `rowStatus` is the temporal row status every
/// effective-dated entity carries. They are different facts.
model Assignment {
  id       String @id @default(cuid())
  tenantId String

  employmentRelationshipId String
  employmentRelationship   EmploymentRelationship @relation(fields: [employmentRelationshipId], references: [id])
  positionId               String
  position                 Position               @relation(fields: [positionId], references: [id])
  managerPositionId        String?

  reasonCode    String
  requestStatus String  @default("Draft")
  rowStatus     String  @default("Effective")
  /// Shared with the compensation record when a promotion moves both.
  correlationId String?
  decisionId    String?

  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  compensationRecords CompensationRecord[]

  @@index([tenantId, employmentRelationshipId, rowStatus])
  @@index([tenantId, positionId])
  @@map("assignments")
}

model CompensationRecord {
  id       String @id @default(cuid())
  tenantId String

  employmentRelationshipId String
  employmentRelationship   EmploymentRelationship @relation(fields: [employmentRelationshipId], references: [id])
  /// Mandatory when `revisionReason` is a promotion [Canon §14.5].
  linkedAssignmentId       String?
  linkedAssignment         Assignment?            @relation(fields: [linkedAssignmentId], references: [id])

  revisionReason String
  amount         Decimal  @db.Decimal(14, 2)
  currency       String   @default("INR")
  /// Monthly gross broken out, so payroll does not re-derive it every run.
  basicPay       Decimal? @db.Decimal(14, 2)
  status         String   @default("Proposed") // R2
  correlationId  String?
  decisionId     String?

  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, employmentRelationshipId, status])
  @@map("compensation_records")
}

// --- Time and absence ------------------------------------------------------

model LeaveType {
  id       String @id @default(cuid())
  tenantId String

  code                     String
  name                     String
  /// Whether taking it moves the employment relationship into OnLeave.
  employmentStateAffecting Boolean @default(false)
  statutory                Boolean @default(false)
  annualEntitlementDays    Decimal @default(0) @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]

  @@unique([tenantId, code])
  @@map("leave_types")
}

/// `balanceDays` is a cached projection of the transaction ledger below. It is
/// never written directly by a service — only recomputed from transactions —
/// which is what makes a balance reconstructable and a dispute answerable.
model LeaveBalance {
  id       String @id @default(cuid())
  tenantId String

  employmentRelationshipId String
  employmentRelationship   EmploymentRelationship @relation(fields: [employmentRelationshipId], references: [id])
  leaveTypeId              String
  leaveType                LeaveType              @relation(fields: [leaveTypeId], references: [id])

  balanceDays Decimal @default(0) @db.Decimal(6, 2)
  heldDays    Decimal @default(0) @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions LeaveTransaction[]

  @@unique([employmentRelationshipId, leaveTypeId])
  @@index([tenantId])
  @@map("leave_balances")
}

/// Append-only. Every movement of a balance is a row here.
model LeaveTransaction {
  id       String @id @default(cuid())
  tenantId String

  leaveBalanceId String
  leaveBalance   LeaveBalance @relation(fields: [leaveBalanceId], references: [id])
  leaveRequestId String?

  txnType     String
  /// Signed: a hold and a deduction are negative, a reversal and an accrual
  /// positive. Summing the column reproduces the balance exactly.
  amountDays  Decimal @db.Decimal(6, 2)
  note        String?
  createdById String?

  createdAt DateTime @default(now())

  @@index([tenantId, leaveBalanceId, createdAt])
  @@map("leave_transactions")
}

model LeaveRequest {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  employmentRelationshipId String
  employmentRelationship   EmploymentRelationship @relation(fields: [employmentRelationshipId], references: [id])
  leaveTypeId              String
  leaveType                LeaveType              @relation(fields: [leaveTypeId], references: [id])

  startDate   DateTime
  endDate     DateTime
  days        Decimal   @db.Decimal(6, 2)
  reason      String?
  status      String    @default("Draft") // Diagram 14.2
  decidedById String?
  decidedAt   DateTime?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, status])
  @@index([tenantId, employmentRelationshipId, startDate])
  @@map("leave_requests")
}

model WorkAttendance {
  id       String @id @default(cuid())
  tenantId String

  employmentRelationshipId String
  employmentRelationship   EmploymentRelationship @relation(fields: [employmentRelationshipId], references: [id])

  workDate        DateTime
  workedMinutes   Int      @default(0)
  overtimeMinutes Int      @default(0)
  status          String   @default("Recorded")
  missingPunch    Boolean  @default(false)
  note            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employmentRelationshipId, workDate])
  @@index([tenantId, workDate])
  @@map("work_attendances")
}

// --- Performance and growth ------------------------------------------------

model Goal {
  id       String @id @default(cuid())
  tenantId String

  employmentRelationshipId String
  employmentRelationship   EmploymentRelationship @relation(fields: [employmentRelationshipId], references: [id])

  keyResultRef String?
  description  String
  status       String    @default("Draft")
  periodLabel  String?
  dueAt        DateTime?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, employmentRelationshipId, status])
  @@map("goals")
}

/// Append-only. There is deliberately no PERFORMANCE_REVIEW entity: a review
/// is a reading of this evidence, not a record that replaces it.
model PerformanceEvidence {
  id       String @id @default(cuid())
  tenantId String

  employmentRelationshipId String
  employmentRelationship   EmploymentRelationship @relation(fields: [employmentRelationshipId], references: [id])

  kind              String
  description       String
  recordedByPartyId String?
  /// ICC and disciplinary evidence. Visible only to principals holding a
  /// grant on `performance_evidence` — not to the line manager by default,
  /// and not to the chairman by seniority.
  caseScoped        Boolean @default(false)
  caseRef           String?

  createdAt DateTime @default(now())

  @@index([tenantId, employmentRelationshipId, createdAt])
  @@index([tenantId, caseScoped])
  @@map("performance_evidence")
}

model LearningActivity {
  id       String @id @default(cuid())
  tenantId String

  title        String
  isCompliance Boolean @default(false)
  cost         Decimal @default(0) @db.Decimal(10, 2)
  /// Optional link to the Education catalogue, so an internally-delivered
  /// course is one course rather than two records of the same thing.
  courseId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  learningRecords LearningRecord[]

  @@index([tenantId])
  @@map("learning_activities")
}

model LearningRecord {
  id       String @id @default(cuid())
  tenantId String

  employmentRelationshipId String
  employmentRelationship   EmploymentRelationship @relation(fields: [employmentRelationshipId], references: [id])
  learningActivityId       String
  learningActivity         LearningActivity       @relation(fields: [learningActivityId], references: [id])

  status      String    @default("Enrolled")
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, employmentRelationshipId])
  @@map("learning_records")
}

// --- Capability Intelligence (§14.6) ---------------------------------------

model Skill {
  id       String @id @default(cuid())
  tenantId String

  name             String
  /// Decay is computed from this at query time, never stored as a decaying
  /// scalar — otherwise every claim would need rewriting nightly and would
  /// still be stale in between.
  halfLifeMonths   Int    @default(24)
  proficiencyScale Json   @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  capabilityClaims CapabilityClaim[]

  @@unique([tenantId, name])
  @@map("skills")
}

model Evidence {
  id       String @id @default(cuid())
  tenantId String

  capabilityClaimId String
  capabilityClaim   CapabilityClaim @relation(fields: [capabilityClaimId], references: [id])

  description String
  sourceRef   String?

  createdAt DateTime @default(now())

  @@index([tenantId, capabilityClaimId])
  @@map("capability_evidence")
}

model VerificationEvent {
  id       String @id @default(cuid())
  tenantId String

  capabilityClaimId String
  capabilityClaim   CapabilityClaim @relation(fields: [capabilityClaimId], references: [id])

  verifierPartyId       String
  /// The two-person rule for a verified claim that moves pay, grade or
  /// posting. Null is legitimate for a claim with no such consequence.
  secondVerifierPartyId String?
  note                  String?
  verifiedAt            DateTime @default(now())

  @@index([tenantId, capabilityClaimId])
  @@map("verification_events")
}

// --- Money out -------------------------------------------------------------

/// The only aggregate the payroll interface owns. Computing pay is not this
/// system's job; instructing it and holding the audit trail is.
model PayrollInstruction {
  id       String @id @default(cuid())
  tenantId String

  employmentRelationshipId String
  employmentRelationship   EmploymentRelationship @relation(fields: [employmentRelationshipId], references: [id])
  payrollRunId             String?
  payrollRun               PayrollRun?            @relation(fields: [payrollRunId], references: [id])

  payPeriod   String // YYYY-MM
  status      String  @default("Draft")
  grossAmount Decimal @default(0) @db.Decimal(14, 2)
  deductions  Decimal @default(0) @db.Decimal(14, 2)
  netAmount   Decimal @default(0) @db.Decimal(14, 2)
  currency    String  @default("INR")
  /// Which division carries the cost, so payroll lands in the same division
  /// cut as revenue does.
  division    String?
  /// Set when the disbursement is posted to the books.
  paymentId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employmentRelationshipId, payPeriod])
  @@index([tenantId, payPeriod, status])
  @@map("payroll_instructions")
}

/// The settlement container for a period, not the computation engine.
model PayrollRun {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  payPeriod  String
  status     String  @default("Draft")
  grossTotal Decimal @default(0) @db.Decimal(16, 2)
  netTotal   Decimal @default(0) @db.Decimal(16, 2)
  headcount  Int     @default(0)

  approvedById String?
  approvedAt   DateTime?
  disbursedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instructions PayrollInstruction[]

  @@unique([tenantId, recordCode])
  @@unique([tenantId, payPeriod])
  @@map("payroll_runs")
}

// --- Onboarding / offboarding ----------------------------------------------

model Onboarding {
  id       String @id @default(cuid())
  tenantId String

  employmentRelationshipId String                 @unique
  employmentRelationship   EmploymentRelationship @relation(fields: [employmentRelationshipId], references: [id])

  status        String  @default("Initiated")
  checklist     Json    @default("[]")
  blockedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@map("onboardings")
}

model Offboarding {
  id       String @id @default(cuid())
  tenantId String

  employmentRelationshipId String                 @unique
  employmentRelationship   EmploymentRelationship @relation(fields: [employmentRelationshipId], references: [id])

  status           String   @default("Initiated")
  checklist        Json     @default("[]")
  disputeReason    String?
  settlementAmount Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@map("offboardings")
}

// ===========================================================================
// The books (bounded context `fin`) — Canon §15.
//
// Invoices, payments and receipts above answer "what is owed and what came in
// against it". They do not answer "what did the company spend, on what, in
// which division, and is that within budget" — which is the question the
// founder's own ledger was built to answer and the one this platform could
// not.
//
// So this adds the ledger spine: accounts money sits in, categories money is
// spent under, and one TRANSACTION table every movement lands in whatever
// raised it — a bank import, a payroll disbursement, an invoice receipt, or
// somebody typing it in. `division` is on the transaction rather than derived,
// because a shared cost split across divisions is a judgement somebody makes
// at the time and cannot be recovered from the category afterwards.
// ===========================================================================

/// Somewhere money sits: a bank account, cash in hand, a card, a loan account.
model LedgerAccount {
  id       String @id @default(cuid())
  tenantId String

  name             String
  accountType      String    @default("bank") // bank | cash | card | loan | wallet
  /// Last four digits at most. The full number is never held here.
  displayReference String?
  openingBalance   Decimal   @default(0) @db.Decimal(18, 2)
  openingDate      DateTime?
  currency         String    @default("INR")
  active           Boolean   @default(true)
  /// Ledger grouping for the balance sheet: asset | liability | equity.
  ledgerGroup      String    @default("asset")

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  transactions Transaction[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
  @@map("ledger_accounts")
}

/// What money is earned or spent under. A shallow tree — the company's own
/// chart, not a statutory one.
model LedgerCategory {
  id       String @id @default(cuid())
  tenantId String

  name      String
  /// income | expense | asset_purchase | transfer | tax | drawings
  kind      String           @default("expense")
  /// recurring_fixed | variable | one_time | annual — how it behaves, which is
  /// what makes a cash budget forecastable rather than a guess.
  behaviour String           @default("variable")
  parentId  String?
  parent    LedgerCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  LedgerCategory[] @relation("CategoryTree")

  /// The division this normally lands in. Overridable per transaction.
  defaultDivision String?
  /// Marks a cost the company cannot defer — rent, salaries, statutory dues.
  mustPay         Boolean @default(false)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  transactions   Transaction[]
  budgetLines    BudgetLine[]
  recurringRules RecurringRule[]

  @@unique([tenantId, name])
  @@index([tenantId, kind])
  @@map("ledger_categories")
}

/// One movement of money. Append-only in spirit: a mistake is reversed with a
/// second row carrying `reversalOfId`, never edited away, so the history keeps
/// showing what actually happened.
model Transaction {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  txnDate   DateTime
  /// in | out. Amount is always positive; the direction carries the sign.
  direction String
  amount    Decimal  @db.Decimal(18, 2)
  currency  String   @default("INR")

  accountId  String
  account    LedgerAccount   @relation(fields: [accountId], references: [id])
  categoryId String?
  category   LedgerCategory? @relation(fields: [categoryId], references: [id])

  /// software | skill | education | shared. Set at entry, never derived, so a
  /// split judgement survives.
  division     String?
  counterparty String?
  method       String  @default("bank_transfer")
  reference    String?
  note         String?

  /// Set by the finance head when the counterparty IS another group entity
  /// (equity-portal plan §1.5, §6 phase 2) — the tenant id of that entity,
  /// validated at entry to be somewhere in this tenant's own group (parent,
  /// sibling or child), never an arbitrary tenant. Listed on the group
  /// screen beside "Group total before inter-company eliminations" so an
  /// accountant doing the consolidation works from a list, not a hunt.
  intercompanyTenantId String?

  /// What raised it: manual | bank_import | payroll | invoice | vendor_bill |
  /// recurring | asset | loan. A figure can always be traced to its origin.
  source       String  @default("manual")
  payrollRunId String?
  invoiceId    String?
  vendorBillId String?
  fixedAssetId String?
  loanId       String?

  /// Set on the row that reverses another, and on the row reversed.
  reversalOfId String?
  reversedById String?

  /// Matched against a bank statement line.
  reconciledAt DateTime?

  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, txnDate])
  @@index([tenantId, categoryId, txnDate])
  @@index([tenantId, division, txnDate])
  @@index([tenantId, accountId, txnDate])
  @@index([tenantId, source])
  @@index([tenantId, intercompanyTenantId])
  @@map("transactions")
}

/// What a supplier is owed. The other half of receivables, which the platform
/// had without its counterpart — a company that can see what it is owed and
/// not what it owes cannot see its position.
model VendorBill {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  vendorName  String
  vendorGstin String?
  billNumber  String?
  billDate    DateTime
  dueDate     DateTime?
  categoryId  String?
  division    String?

  subtotal   Decimal @default(0) @db.Decimal(18, 2)
  taxAmount  Decimal @default(0) @db.Decimal(18, 2)
  total      Decimal @default(0) @db.Decimal(18, 2)
  paidAmount Decimal @default(0) @db.Decimal(18, 2)
  currency   String  @default("INR")

  /// draft | open | part_paid | paid | cancelled
  status String  @default("open")
  note   String?

  overdueNotifiedAt DateTime?
  createdById       String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, vendorName])
  @@map("vendor_bills")
}

/// A budget line for one category, one period, one division. Actuals are
/// summed from transactions rather than stored, so a late entry moves the
/// variance instead of leaving it stale.
model BudgetLine {
  id       String @id @default(cuid())
  tenantId String

  /// YYYY-MM, or YYYY for an annual line.
  period     String
  categoryId String
  category   LedgerCategory @relation(fields: [categoryId], references: [id])
  division   String?
  amount     Decimal        @db.Decimal(18, 2)
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, period, categoryId, division])
  @@index([tenantId, period])
  @@map("budget_lines")
}

/// Something that happens every month whether anybody remembers it or not.
/// Generating the transaction is deliberate rather than automatic — a rule
/// that posts silently is how a ledger fills with entries nobody checked.
model RecurringRule {
  id       String @id @default(cuid())
  tenantId String

  label               String
  categoryId          String
  category            LedgerCategory @relation(fields: [categoryId], references: [id])
  accountId           String
  division            String?
  direction           String         @default("out")
  amount              Decimal        @db.Decimal(18, 2)
  /// monthly | quarterly | annual
  cadence             String         @default("monthly")
  dayOfMonth          Int            @default(1)
  startDate           DateTime
  endDate             DateTime?
  active              Boolean        @default(true)
  /// The last period a transaction was generated for, so generating twice for
  /// one month is impossible rather than merely unlikely.
  lastGeneratedPeriod String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active])
  @@map("recurring_rules")
}

/// A capital purchase and how it is written down. The schedule is computed
/// from these rather than stored, so changing the life corrects every future
/// period at once instead of leaving a stale table behind.
model FixedAsset {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  name             String
  purchaseDate     DateTime
  cost             Decimal   @db.Decimal(18, 2)
  salvageValue     Decimal   @default(0) @db.Decimal(18, 2)
  usefulLifeMonths Int
  /// straight_line | wdv (written-down value, which is what Indian tax uses)
  method           String    @default("straight_line")
  wdvRate          Decimal   @default(0) @db.Decimal(6, 4)
  division         String?
  categoryId       String?
  disposedAt       DateTime?
  disposalValue    Decimal?  @db.Decimal(18, 2)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, disposedAt])
  @@map("fixed_assets")
}

/// Borrowing, with its amortisation computed rather than stored for the same
/// reason as depreciation.
model Loan {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  lender       String
  principal    Decimal   @db.Decimal(18, 2)
  /// Annual nominal rate, as a percentage.
  annualRate   Decimal   @db.Decimal(6, 3)
  tenureMonths Int
  startDate    DateTime
  accountId    String?
  division     String?
  /// Closed early, or run to term.
  closedAt     DateTime?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, closedAt])
  @@map("loans")
}

// ---------------------------------------------------------------------------
// Imports (§15.9)
//
// A company's history does not begin when it installs an ERP. It arrives as a
// Tally export, a bank statement and a payroll spreadsheet, and the platform is
// worth nothing until those are in it.
//
// Import is staged rather than immediate: parse, map, preview, then commit. The
// file is a record, its rows are records, and every figure that lands in the
// books carries the id of the row it came from — so "where did this ₹76,000
// come from" is answerable in one join rather than by opening the original
// spreadsheet and hoping it has not changed.
// ---------------------------------------------------------------------------

/// One uploaded file and what became of it.
model ImportBatch {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  fileName    String
  fileSize    Int
  /// SHA-256 of the bytes. Re-uploading the same file is recognised as the
  /// same file rather than duplicating a year of the ledger.
  contentHash String

  /// tally_ledger | bank_statement | employees | salary | attendance |
  /// transactions | chart_of_accounts
  kind         String
  /// xlsx | csv | tally_xml
  sourceFormat String
  /// What the sniffer thought it was, kept even when the user overrides it, so
  /// a misdetection is visible rather than silently corrected.
  detectedAs   String?
  /// The sheet or section the rows came from.
  sourceLabel  String?

  /// parsed | previewed | committed | failed | reverted
  status String @default("parsed")

  /// Column-to-field mapping, editable before commit.
  mapping Json @default("{}")
  /// Counts by row status, plus anything the parser wants to say.
  stats   Json @default("{}")
  /// Options the commit honours: target account, default division, date format.
  options Json @default("{}")

  errorMessage String?

  createdById String?
  committedAt DateTime?
  revertedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rows ImportRow[]

  @@unique([tenantId, recordCode])
  @@index([tenantId, status])
  @@index([tenantId, contentHash])
  @@map("import_batches")
}

/// One line of the file, before and after normalisation.
model ImportRow {
  id       String      @id @default(cuid())
  tenantId String
  batchId  String
  batch    ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  /// 1-based, as the spreadsheet numbers it, so an error message names a row
  /// the user can actually find.
  rowNumber Int

  /// Exactly what was in the file.
  raw        Json
  /// What it became. Null until mapping runs.
  normalised Json?

  /// pending | ready | duplicate | error | committed | skipped
  status  String  @default("pending")
  message String?

  /// What it turned into, once committed.
  entityType String?
  entityId   String?

  /// Stable identity for this line, so re-importing an overlapping statement
  /// recognises what it has already seen.
  dedupeKey String?

  createdAt DateTime @default(now())

  @@index([tenantId, batchId, rowNumber])
  @@index([tenantId, dedupeKey])
  @@index([batchId, status])
  @@map("import_rows")
}
