// Kaizen Unified Operating Platform — data model.
//
// Two structural facts hold across every model and are not restated per entity:
//
//   1. `tenantId` is present on every row from creation (CRM-FOUND-001). Every
//      compound index is tenant-leading, so a cross-tenant scan is never
//      index-eligible. Every previously-global unique constraint is
//      tenant-scoped.
//   2. Every entity carrying a human-readable identifier uses the unified
//      record-code scheme <TYPE>-<YYYY>-<NNNNN> (CRM-FOUND-007), generated per
//      tenant per type, gapless within a year, immutable after creation.
//
// Soft delete is `deletedAt`, never a hard delete, on every governed entity.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// P0 — Tenancy & Trust Fabric
// ===========================================================================

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String   @default("active") // active | suspended | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The explicit bootstrap authority set — who may create the first POLICY or
  /// GRANT for a new tenant. Owned by SYS, it breaks the circularity of the
  /// permission system needing permission to create itself.
  config Json @default("{}")

  users           User[]
  people          Person[]
  organizations   Organization[]
  events          EventRecord[]
  recordSequences RecordSequence[]

  @@map("tenants")
}

/// Per-tenant, per-type, per-year sequence backing the record-code generator.
/// Gapless within the year; an atomic increment guarantees no two records
/// receive the same sequence under concurrency.
model RecordSequence {
  id           String @id @default(cuid())
  tenantId     String
  entityType   String
  year         Int
  nextSequence Int    @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType, year])
  @@map("record_sequences")
}

// ===========================================================================
// P1 — Party & Identity
// ===========================================================================

/// One PERSON row per real human, forever. PERSON itself never records a role
/// or a relationship — that is what AFFILIATION and RELATIONSHIP are for.
///
/// Phone/email indexes are deliberately NOT unique: a 409-with-candidates from
/// the dedup service is the mechanism, not a driver-level duplicate-key error.
model Person {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  fullName                 String
  primaryPhone             String?
  primaryEmail             String?
  primaryPhoneNormalised   String?
  primaryEmailNormalised   String?
  additionalPhones         String[] @default([])
  additionalEmails         String[] @default([])
  additionalPhonesNormalised String[] @default([])
  additionalEmailsNormalised String[] @default([])

  /// {system, id} pairs. Never fabricated — absent is safe, wrong is not.
  externalIds Json @default("[]")

  dedupeStatus String  @default("active") // active | merged | flagged_duplicate
  mergedIntoId String?
  mergedInto   Person? @relation("PersonMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Person[] @relation("PersonMerge")

  /// Field-level sensitivity classification consulted by both the write-audit
  /// path and the regulated-field read-audit path.
  fieldClassifications Json @default("{}")

  notes     String?
  createdById String?
  updatedById String?
  source      String   @default("manual")
  deletedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  affiliations Affiliation[]
  users        User[]
  leads        Lead[]

  @@unique([tenantId, recordCode])
  @@index([tenantId, primaryPhoneNormalised])
  @@index([tenantId, primaryEmailNormalised])
  @@index([tenantId, dedupeStatus])
  @@index([tenantId, fullName])
  @@map("people")
}

/// A time-bounded record of HOW a PERSON relates to Kaizen right now. A person
/// can hold multiple active affiliations simultaneously. Access and visibility
/// derive from Affiliations, never from PERSON directly.
model Affiliation {
  id       String @id @default(cuid())
  tenantId String

  partyId         String
  party           Person @relation(fields: [partyId], references: [id], onDelete: Cascade)
  counterpartyId  String?
  counterpartyName String?
  affiliationType String // employee | student | customer_contact | ...

  /// The ACCESS_ROLE this affiliation carries. Never a permission itself —
  /// a GRANT references a role and a POLICY_VERSION.
  roleSlug String?

  status        String    @default("active") // active | suspended | ended
  primaryFlag   Boolean   @default(false)
  specialisationId String?
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  priorAffiliationId String?

  /// Employee/student affiliations carry a statutory retention floor: a dedup
  /// match against one never auto-merges, regardless of confidence.
  statutoryRetentionFloor Boolean @default(false)

  orgUnitId String?
  branch    String?
  positionId String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, partyId, status])
  @@index([tenantId, affiliationType, status])
  @@map("affiliations")
}

/// Raised whenever a dedup match is ambiguous, cross-scope, or hits a statutory
/// retention floor. Drained by human action, never auto-expired.
model MergeCandidate {
  id       String @id @default(cuid())
  tenantId String

  incomingPayload Json
  candidatePersonId String
  confidence      Float
  matchedOn       String[] @default([])
  raisedReason    String   // cross_scope | ambiguous | statutory_retention_floor
  state           String   @default("open") // open | confirmed | rejected | deferred

  resolvedById String?
  resolvedAt   DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, state, createdAt])
  @@map("merge_candidates")
}

/// The single Party-model specialisation for any legal or institutional body —
/// one row per real legal body, forever. `category` as an exclusive gate is
/// removed; `legacyCategory` survives transitionally for reporting only.
model Organization {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  name        String
  website     String?
  parentOrgId String?
  parentOrg   Organization?  @relation("OrgHierarchy", fields: [parentOrgId], references: [id])
  children    Organization[] @relation("OrgHierarchy")

  locations Json     @default("[]")
  tags      String[] @default([])
  ownerPartyId String?

  legacyCategory String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account            Account?
  institutionProfile InstitutionProfile?
  leads              Lead[]
  opportunities      Opportunity[]

  @@unique([tenantId, recordCode])
  @@index([tenantId, name])
  @@map("organizations")
}

/// The CRM commercial-relationship specialisation. Independent of
/// InstitutionProfile — both may exist on the same Organization simultaneously,
/// with no cross-specialisation exclusivity check anywhere in validation.
model Account {
  id       String @id @default(cuid())
  tenantId String

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  tier              String  @default("standard") // strategic | key | standard | long_tail
  ownerPartyId      String?
  billingEmail      String?
  billingAddress    String?
  paymentTermsDays  Int?
  annualRevenueBand String?
  employeeCountBand String?

  attachedById String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, tier])
  @@map("accounts")
}

/// The education/institutional-partnership specialisation. Formerly the
/// conditionally-null `institution_details` sub-document; now a sibling
/// specialisation governed by its own `institutions:*` grant family.
model InstitutionProfile {
  id       String @id @default(cuid())
  tenantId String

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  institutionType String?
  managementType  String?
  address         String?
  district        String?
  taluk           String?
  state           String?
  latitude        Float?
  longitude       Float?

  /// AISHE/UDISE+ — never fabricated; left null instead.
  externalIdentifier String?
  establishedYear    Int?
  studentCount       Int?
  departments        String[] @default([])
  strategicPriority  String?

  attachedById String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId, district, institutionType])
  @@index([tenantId, externalIdentifier])
  @@map("institution_profiles")
}

// ===========================================================================
// P3 — Relationship Graph
// ===========================================================================

/// A first-class polymorphic edge. History is preserved by never overwriting a
/// Relationship in place when its nature changes — a new role or employer
/// produces a NEW row with its own startDate, and the prior one gets an endDate.
/// `status` and `strength` alone may be updated in place: refinements of the
/// same ongoing relationship, not nature changes.
model Relationship {
  id       String @id @default(cuid())
  tenantId String

  fromType String
  fromId   String
  toType   String
  toId     String

  relationshipType String
  role             String?
  status           String  @default("active") // active | inactive | ended
  strength         String  @default("moderate") // weak | moderate | strong
  ownerPartyId     String?

  startDate DateTime  @default(now())
  endDate   DateTime?
  notes     String?

  supersededById String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, fromType, fromId])
  @@index([tenantId, toType, toId])
  @@index([tenantId, relationshipType, status])
  @@map("relationships")
}

// ===========================================================================
// P7 — Governance: policies, grants, roles, decisions
// ===========================================================================

/// Retained as the ACCESS_ROLE reference. It stops being the terminus of the
/// permission chain — a GRANT references a Role AND a POLICY_VERSION.
model AccessRole {
  id       String @id @default(cuid())
  tenantId String

  slug        String
  name        String
  description String?
  archetype   String  @default("workspace") // command | workspace | portal | console
  /// The WHAT-axis ceiling this role may read up to.
  classificationCeiling String @default("internal")
  isSystem    Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grants Grant[]

  @@unique([tenantId, slug])
  @@map("access_roles")
}

/// A named, versioned rule set. POLICY_VERSION is an immutable snapshot
/// referenced by any decision that relied on it, so a past decision stays
/// re-explainable against the rule in force at decision time.
model Policy {
  id       String @id @default(cuid())
  tenantId String

  policyCode  String // POL-CRM-MOU-APPROVAL
  name        String
  description String?
  kind        String  @default("permission") // permission | approval_gate | threshold
  currentVersionId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions PolicyVersion[]

  @@unique([tenantId, policyCode])
  @@map("policies")
}

model PolicyVersion {
  id       String @id @default(cuid())
  tenantId String

  policyId String
  policy   Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  version  Int

  /// The rule content: required_permission, authority_test,
  /// approver_resolution, the Self-Dealing Bar clause, applies_to.
  content Json

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  authoredById  String?
  createdAt     DateTime  @default(now())

  grants Grant[]

  @@unique([policyId, version])
  @@index([tenantId, effectiveFrom])
  @@map("policy_versions")
}

/// The durable record of "this role or principal may take this action on this
/// resource", replacing the disposable roles-collection projection the legacy
/// migration overwrote on every deploy.
model Grant {
  id       String @id @default(cuid())
  tenantId String

  principalType String  @default("role") // role | individual | agent
  roleId        String?
  role          AccessRole? @relation(fields: [roleId], references: [id], onDelete: Cascade)
  principalId   String?

  policyVersionId String?
  policyVersion   PolicyVersion? @relation(fields: [policyVersionId], references: [id])

  resource String
  verbs    String[] // view | create | edit | delete | assign | export | financial | approve | merge
  scope    String   @default("all") // own | own_or_unowned | all

  /// Extra scope resolvers beyond own/own_or_unowned — e.g. `batch_member`,
  /// which expresses "trainer scoped to own batch" as data rather than as six
  /// hard-coded role-slug comparisons in service code.
  scopeResolver String?
  conditions    Json    @default("{}")

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId, roleId, resource])
  @@index([tenantId, principalId, resource])
  @@map("grants")
}

/// The HOW MUCH axis — a value, count, or risk-class limit bound to a principal,
/// human or agent. A principal with no resolvable AUTHORITY_GRANT defaults to
/// "no elevated authority": fail-closed, not fail-open.
model AuthorityGrant {
  id       String @id @default(cuid())
  tenantId String

  principalType String // human | agent
  principalId   String
  principalLabel String?

  authorityClass String // mou_approval | contract_approval | discount_approval | agent_draft
  ceilingValue   Decimal? @db.Decimal(18, 2)
  currency       String?
  countCeiling   Int?
  countWindow    String?
  riskClassCeiling String?

  status        String    @default("active") // active | paused | revoked
  grantedById   String?
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  revokedAt     DateTime?
  revokedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, principalId, authorityClass])
  @@map("authority_grants")
}

/// An approval gate instance opened by a privileged transition or an
/// over-ceiling action.
model ApprovalStep {
  id       String @id @default(cuid())
  tenantId String

  policyId       String?
  policyVersion  Int?
  subjectType    String
  subjectId      String
  subjectLabel   String?
  action         String // mou.approve | contract.sign | quote.issue

  requestedById   String
  requestedAt     DateTime @default(now())
  requestedValue  Decimal? @db.Decimal(18, 2)
  currency        String?

  /// Resolved deterministically, before any notification fires.
  resolvedApproverId    String?
  resolvedApproverRole  String?
  resolutionTier        Int      @default(0)
  /// Set when the Self-Dealing Bar rerouted resolution to the next tier.
  selfDealingBarTripped Boolean  @default(false)

  state       String    @default("open") // open | approved | declined | escalated | withdrawn
  decidedById String?
  decidedAt   DateTime?
  decisionNote String?

  slaDueAt      DateTime?
  escalatedAt   DateTime?
  escalationRung Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, state, slaDueAt])
  @@index([tenantId, resolvedApproverId, state])
  @@map("approval_steps")
}

/// A governance decision routed to a principal whose authority genuinely
/// exceeds every grant below them on the escalation path.
model Decision {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  question     String
  state        String @default("Raised")
  subjectType  String
  subjectId    String
  subjectLabel String?

  authorityBasis        String
  requiredAuthorityValue Decimal? @db.Decimal(18, 2)
  currency              String?
  routedToPartyId       String?
  routedToRole          String?

  /// The seven mandatory components, assembled before routing, never after.
  evidencePack       Json    @default("{}")
  evidenceComplete   Boolean @default(false)

  /// Recorded before the outcome is known — the raw material for the
  /// decision-quality calibration widget.
  confidence Float?

  chosenOption String?
  rationale    String?
  rationaleAudioRef String?
  decidedById  String?
  decidedAt    DateTime?

  deferUntil       DateTime?
  pointOfNoReturn  DateTime?
  reviewDueOn      DateTime?
  outcomeAssessment String?
  varianceBand     String?
  changeCommitment String?
  changeCommitmentResolved Boolean @default(false)

  raisedAt  DateTime @default(now())
  slaDueAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  delegations Delegation[]

  @@unique([tenantId, recordCode])
  @@index([tenantId, state, raisedAt])
  @@index([tenantId, routedToPartyId, state])
  @@map("decisions")
}

/// Bounded, named, dated. No sub-delegation.
model Delegation {
  id       String @id @default(cuid())
  tenantId String

  decisionId String?
  decision   Decision? @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  fromPartyId String
  toPartyId   String
  scope       String
  reason      String

  effectiveFrom DateTime  @default(now())
  returnDueOn   DateTime
  returnedAt    DateTime?
  returnedUnactioned Boolean @default(false)
  state         String    @default("active") // active | returned | expired

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, toPartyId, state])
  @@map("delegations")
}

// ===========================================================================
// P4 — Event Fabric
// ===========================================================================

/// Durable, append-only, hash-chained, replayable. Every fact-changing action
/// writes one. Reads never emit events — a read of confidential or regulated
/// data produces an AUDIT_RECORD instead.
model EventRecord {
  id       String @id @default(cuid())
  tenantId String

  eventId      String
  eventName    String
  eventVersion Int    @default(1)

  occurredAt DateTime
  recordedAt DateTime @default(now())

  actorType         String
  actorPartyId      String?
  actorAccessRole   String?
  actorAgentId      String?
  onBehalfOfPartyId String?

  subjectEntityType String
  subjectEntityId   String
  subjectRecordCode String?

  related       Json @default("[]")
  previousState Json?
  newState      Json?
  reason        Json?
  source        Json @default("{}")
  impactDomains String[] @default([])
  impactSeverity String?
  impactMateriality Json?
  ownerPartyId    String?
  ownerPositionId String?

  correlationId String
  causationId   String?

  confidentiality String @default("internal")
  retentionClass  String @default("standard")

  /// The hash-chain linkage that makes the log tamper-evident and replayable.
  /// A chain-continuity failure alerts per tenant, never merely logs.
  prevHash String?
  hash     String

  /// Set during the dual-publish migration window so both names are
  /// recognisable as the same fact.
  legacyName String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventId, eventName])
  @@index([tenantId, recordedAt])
  @@index([tenantId, eventName, occurredAt])
  @@index([tenantId, subjectEntityType, subjectEntityId])
  @@index([tenantId, correlationId])
  @@map("event_records")
}

/// A handler's third failure writes here rather than only logging, so a process
/// restart does not lose an in-flight retry.
model EventDeadLetter {
  id       String @id @default(cuid())
  tenantId String

  eventRecordId String
  eventName     String
  subscriberKey String
  attempts      Int    @default(0)
  lastError     String
  payload       Json

  state       String    @default("dead") // pending | dead | replayed
  createdAt   DateTime  @default(now())
  replayedAt  DateTime?

  @@index([tenantId, state, createdAt])
  @@map("event_dead_letters")
}

// ===========================================================================
// Audit
// ===========================================================================

/// Append-only, no update or delete path. Write-audit for every governed
/// entity; read-audit for regulated fields only, preserving the original
/// performance-driven design for the common case.
model AuditRecord {
  id       String @id @default(cuid())
  tenantId String

  action      String // create | update | delete | merge | export | login | permission_change | read
  subjectType String
  subjectId   String

  actorType    String   @default("human")
  actorId      String?
  actorLabel   String?
  actorAgentId String?

  /// Changed keys only — noise fields dropped.
  diff Json?
  /// Populated only on regulated-field reads. Names only, never values.
  fieldsRead String[] @default([])
  meta       Json?

  timestamp DateTime @default(now())

  @@index([tenantId, subjectType, subjectId, timestamp])
  @@index([tenantId, actorId, timestamp])
  @@index([tenantId, timestamp])
  @@map("audit_records")
}

// ===========================================================================
// Users & sessions
// ===========================================================================

model User {
  id       String @id @default(cuid())
  tenantId String

  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  email        String
  passwordHash String
  status       String  @default("active") // active | invited | suspended
  branch       String?

  /// Server-side carriage. Never client-trusted.
  activeAffiliationId String?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId, personId])
  @@map("users")
}

/// Watermark-relative delta state. `reachSignature` — a hash over resolved
/// scope, policy version and consent state — lets the delta engine distinguish
/// "forty exceptions just appeared because your portfolio widened" from "forty
/// things just broke".
model AttentionWatermark {
  id       String @id @default(cuid())
  tenantId String

  userId         String
  affiliationId  String
  lastSeenAt     DateTime @default(now())
  reachSignature String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId, affiliationId])
  @@map("attention_watermarks")
}

// ===========================================================================
// Pipeline as data (CRM-LEAD-001/002)
// ===========================================================================

model PipelineDefinition {
  id       String @id @default(cuid())
  tenantId String

  pipelineCode          String
  name                  String
  commercialMotion      String
  appliesToVerticals    String[] @default([])
  appliesToAccountKind  String   @default("any")
  defaultForecastMethod String   @default("weighted_stage")
  requiresAwardArtefact String   @default("none")
  isDefault             Boolean  @default(false)

  /// A tenant may additionally require manager-level grant for commit
  /// promotion above a value threshold — a configurable toggle, not a fixed rule.
  commitApprovalThreshold Decimal? @db.Decimal(18, 2)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdById   String?
  updatedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stages      PipelineStage[]
  transitions PipelineTransition[]
  leads       Lead[]
  opportunities Opportunity[]

  @@unique([tenantId, pipelineCode])
  @@index([tenantId, effectiveFrom])
  @@map("pipeline_definitions")
}

model PipelineStage {
  id       String @id @default(cuid())
  tenantId String

  pipelineId String
  pipeline   PipelineDefinition @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  /// Immutable once referenced by a live record: a rename retires the old key
  /// and creates a new one, so historical stage_changed events stay
  /// interpretable without a rename-history join.
  stageKey String
  label    String
  sequence Int

  defaultProbability Int @default(0)
  /// One of the closed eight canonical values {0,10,20,30,40,50,60,90}.
  pipelinePosition   Int

  isOpen     Boolean @default(true)
  isTerminal Boolean @default(false)
  /// Retired post-award states: no transition may target one after cutover.
  postAward  Boolean @default(false)

  /// null means no SLA clock on this stage.
  stageAgeBudgetDays Int?
  requiredFields     String[] @default([])
  entryPredicate     Json     @default("{}")
  exitPredicate      Json     @default("{}")

  retiredAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([pipelineId, stageKey])
  @@unique([pipelineId, sequence])
  @@index([tenantId, pipelineId, pipelinePosition])
  @@map("pipeline_stages")
}

/// The permitted moves between stages — a directed graph the platform enforces,
/// not a value any caller can set.
model PipelineTransition {
  id       String @id @default(cuid())
  tenantId String

  pipelineId String
  pipeline   PipelineDefinition @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  /// null = the initial creation transition.
  fromStageKey String?
  toStageKey   String

  requiresApproval   Boolean @default(false)
  /// A grant path evaluated under the five-axis formula, never a role-slug string.
  requiredPermission String  @default("opportunities:edit")
  emitsEvent         String  @default("kz.crm.opportunity.stage_changed")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pipelineId, fromStageKey, toStageKey])
  @@index([tenantId, pipelineId])
  @@map("pipeline_transitions")
}

// ===========================================================================
// Territory & routing
// ===========================================================================

model Territory {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  name               String
  geoAreaRef         String[] @default([]) // district list or polygon reference
  appliesToVerticals String[] @default([])
  appliesToAccountKind String @default("any")
  /// A position, not a named user — survives personnel change.
  ownerPositionId    String?
  ownerPartyId       String?
  capacityCeiling    Int      @default(50)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]

  @@unique([tenantId, recordCode])
  @@index([tenantId, active])
  @@map("territories")
}

model RoutingRule {
  id       String @id @default(cuid())
  tenantId String

  name     String
  active   Boolean @default(true)
  priority Int     @default(100)

  /// Six factors in declared, tenant-configurable order. Hard filters run
  /// first: assigning outside territory or grant is an authorization error,
  /// not a preference, so a candidate failing either is never scored at all.
  factorWeights Json @default("{\"capacity\":30,\"capability\":25,\"relationship_strength\":30,\"round_robin\":15}")
  /// Round-robin breaks ties only among candidates within this margin of top score.
  tieBreakMarginPoints Int @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, active, priority])
  @@map("routing_rules")
}

/// Every routing evaluation is logged with the full candidate set considered,
/// their per-factor scores, and the winner — so a disputed assignment is fully
/// reconstructable, matching the transparency discipline applied to lead scoring.
model RoutingAudit {
  id       String @id @default(cuid())
  tenantId String

  leadId       String
  territoryId  String?
  evaluatedAt  DateTime @default(now())
  candidates   Json
  winnerPartyId String?
  unroutedReason String?

  @@index([tenantId, leadId])
  @@map("routing_audits")
}

/// Feeds the routing engine's Capability factor. Never auto-asserted at
/// `verified` tier — an AI may propose a claim for a human to confirm.
model CapabilityClaim {
  id       String @id @default(cuid())
  tenantId String

  partyId    String
  offeringId String?
  vertical   String?
  /// claimed | assessed | demonstrated | verified
  tier       String  @default("claimed")
  evidence   String?
  assertedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, partyId])
  @@map("capability_claims")
}

// ===========================================================================
// Lead & Opportunity
// ===========================================================================

model Lead {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  title String

  personId String?
  person   Person? @relation(fields: [personId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  vertical   String
  offeringId String?
  offering   Offering? @relation(fields: [offeringId], references: [id])
  /// Preserved verbatim, never silently discarded, through the catalog migration.
  legacyProductText String?

  pipelineId String
  pipeline   PipelineDefinition @relation(fields: [pipelineId], references: [id])
  stageKey   String
  stageEnteredAt DateTime @default(now())
  legacyStage       String?
  legacyVerticalStage String?

  leadStatus String @default("open")

  /// Routing-assigned, never creator-set. `open` + null owner is the canonical
  /// `unrouted` predicate — one source of truth, not a separate boolean flag.
  ownerPartyId   String?
  territoryId    String?
  territory      Territory? @relation(fields: [territoryId], references: [id])
  unroutedReason String?
  routedAt       DateTime?

  score        Int      @default(0)
  scoreReasons String[] @default([])

  source         String  @default("manual")
  sourceDetail   String?
  estimatedValue Decimal? @db.Decimal(18, 2)
  currency       String   @default("INR")

  lastInteractionAt      DateTime?
  untouchedNotifiedAt    DateTime?
  convertedOpportunityId String?

  createdById String?
  updatedById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, leadStatus, ownerPartyId])
  @@index([tenantId, pipelineId, stageKey])
  @@index([tenantId, createdAt])
  @@map("leads")
}

model Opportunity {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  title String

  accountId      String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  primaryContactPersonId String?
  leadId         String?

  vertical   String
  offeringId String?
  offering   Offering? @relation(fields: [offeringId], references: [id])
  legacyProductText String?

  pipelineId String
  pipeline   PipelineDefinition @relation(fields: [pipelineId], references: [id])
  stageKey   String
  stageEnteredAt DateTime @default(now())
  legacyStage String?

  /// Second state-machine field, deliberately decoupled from stageKey: a deal
  /// can sit in negotiating for weeks without ever being confidently committable.
  forecastCategory             String    @default("pipeline")
  forecastCategoryChangedAt    DateTime?
  forecastCategoryChangeReason String?

  expectedValue     Decimal?  @db.Decimal(18, 2)
  currency          String    @default("INR")
  expectedCloseDate DateTime?

  ownerPartyId   String?
  strategicValue String?

  /// Gates the `proposed` stage transition.
  proposalId     String?
  /// Denormalised read model, event-sourced from PCT. Never written directly
  /// by CRM service code.
  proposalSentAt DateTime?
  proposalPendingNotifiedAt DateTime?
  quoteId    String?
  /// The won-gate reads contractId OR mouId in the service layer, never a
  /// document reference — a document's existence proves nothing about signature.
  contractId String?
  mouId      String?
  /// The PL-RENEWAL chain. A renewal never re-opens the original opportunity.
  parentContractId String?

  outcome      String?
  lostReason   String?
  closedAt     DateTime?
  stageAgeNotifiedAt DateTime?

  createdById String?
  updatedById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, pipelineId, stageKey])
  @@index([tenantId, forecastCategory])
  @@index([tenantId, ownerPartyId])
  @@index([tenantId, expectedCloseDate])
  @@map("opportunities")
}

// ===========================================================================
// Commercial catalog
// ===========================================================================

model Offering {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  offeringCode String
  name         String
  description  String?
  vertical     String
  deliveryModel String
  /// The field Finance reads to derive revenue recognition without a manual
  /// sales conversation per deal.
  defaultRevenueTreatment String
  status       String @default("draft")
  owningBusinessUnit String?
  legacyProductStrings String[] @default([])

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdById   String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  priceBookEntries PriceBookEntry[]
  leads            Lead[]
  opportunities    Opportunity[]

  @@unique([tenantId, offeringCode])
  @@index([tenantId, status, vertical])
  @@map("offerings")
}

/// Repricing never mutates an existing entry — it creates a new version and
/// flips the prior row to `superseded`, preserving the exact price a quote was
/// built against even after the list price moves on.
model PriceBookEntry {
  id       String @id @default(cuid())
  tenantId String

  offeringId String
  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  priceBookId   String @default("standard")
  priceBookName String @default("Standard List")

  currency         String
  unitPrice        Decimal @db.Decimal(18, 2)
  billingFrequency String
  minQuantity      Int     @default(1)
  /// Required, non-nullable, deliberately set — the ceiling the discount
  /// authority gate compares against. Never defaults to 100.
  maxDiscountPct   Int

  status  String @default("active") // active | superseded
  version Int    @default(1)

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  quoteLines QuoteLine[]

  @@unique([offeringId, priceBookId, version])
  @@index([tenantId, offeringId, status])
  @@index([tenantId, priceBookId, currency])
  @@map("price_book_entries")
}

// ===========================================================================
// PCT — proposals, quotes, contracts, MoU, partner agreements
// ===========================================================================

model Proposal {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  opportunityId String
  quoteId       String?
  title         String

  totalValue Decimal? @db.Decimal(18, 2)
  currency   String   @default("INR")
  documentId String?

  sentAt     DateTime?
  validUntil DateTime?
  response   String    @default("pending")
  respondedAt DateTime?

  stalledNotifiedAt DateTime?
  ownerPartyId String?
  createdById  String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, opportunityId])
  @@index([tenantId, response, sentAt])
  @@map("proposals")
}

model Quote {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  opportunityId String
  version       Int    @default(1)
  status        String @default("draft")

  subtotal      Decimal? @db.Decimal(18, 2)
  discountTotal Decimal? @db.Decimal(18, 2)
  grandTotal    Decimal? @db.Decimal(18, 2)
  currency      String   @default("INR")

  issuedAt   DateTime?
  validUntil DateTime?

  /// Set when AU-CRM-011 blocks issue: the whole quote blocks, never a partial
  /// issue with some lines through.
  blockedReason  String?
  approvalStepId String?

  ownerPartyId String?
  createdById  String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines QuoteLine[]

  @@unique([tenantId, recordCode])
  @@index([tenantId, opportunityId, version])
  @@map("quotes")
}

model QuoteLine {
  id       String @id @default(cuid())
  tenantId String

  quoteId String @map("quote_id")
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// A line always resolves against a specific entry AND version, never
  /// "the current price for this offering" — this is what makes a quote
  /// reproducible six months after issue.
  priceBookEntryId      String
  priceBookEntry        PriceBookEntry @relation(fields: [priceBookEntryId], references: [id])
  priceBookEntryVersion Int

  quantity      Int     @default(1)
  listUnitPrice Decimal @db.Decimal(18, 2)
  discountPct   Int     @default(0)
  discountAmount Decimal? @db.Decimal(18, 2)
  lineTotal      Decimal? @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@index([tenantId, quoteId])
  @@map("quote_lines")
}

/// MoU and Contract are deliberately NOT a supertype/subtype pair. They share a
/// design pattern because the underlying business facts differ: an MoU is a
/// coverage instrument that may carry zero commercial value; a contract is
/// always a priced commitment.
model Mou {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String
  /// The pre-migration KAIZEN-YYYY-NNN value, preserved verbatim.
  legacyReference String?

  title          String
  organizationId String?
  institutionId  String?
  opportunityId  String?
  ownerPartyId   String?
  documentId     String?

  scope    String?
  vertical String?

  status String @default("proposed")

  /// May legitimately be zero — an MoU is a coverage instrument.
  commercialValue Decimal? @db.Decimal(18, 2)
  currency        String   @default("INR")
  strategicValue  String?
  termMonths      Int?

  startDate  DateTime?
  endDate    DateTime?
  signedDate DateTime?

  renewedFromId String?
  /// Idempotency marker for the escalation ladder — the rung already notified.
  expiryNotifiedDays Int[] @default([])

  approvedById String?
  approvedAt   DateTime?
  signedById   String?

  notes     String?
  createdById String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, status, endDate])
  @@index([tenantId, organizationId])
  @@map("mous")
}

model Contract {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  title          String
  organizationId String?
  accountId      String?
  institutionId  String?
  opportunityId  String?
  quoteId        String?
  ownerPartyId   String?
  documentId     String?

  status String @default("proposed")

  /// Required, must be > 0 — unlike MoU, an unpriced contract is a modelling error.
  commercialValue Decimal @db.Decimal(18, 2)
  currency        String  @default("INR")
  strategicValue  String?
  termMonths      Int?

  startDate  DateTime?
  endDate    DateTime?
  signedDate DateTime?

  renewedFromId String?
  /// Wider than MoU's 90/60/30/7: a priced commitment needs longer renewal lead time.
  expiryNotifiedDays Int[] @default([])

  terminatedAt     DateTime?
  terminationReason String?

  approvedById String?
  approvedAt   DateTime?
  signedById   String?

  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, status, endDate])
  @@index([tenantId, opportunityId])
  @@map("contracts")
}

/// Modelled deliberately on MoU's exact shape rather than invented fresh.
/// Creation is blocked without an existing or atomically-created `partner_of`
/// relationship edge. Explicitly not a commission engine.
model PartnerAgreement {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  title                 String
  partnerOrganizationId String
  relationshipId        String?
  agreementType         String
  scope                 String?
  territoryScope        String?
  /// A pointer only — commission calculation is deferred, out of scope.
  commercialTermsRef    String?

  status String @default("proposed")

  commercialValue Decimal? @db.Decimal(18, 2)
  currency        String   @default("INR")
  strategicValue  String?
  termMonths      Int?

  startDate DateTime?
  endDate   DateTime?
  signedDate DateTime?

  renewedFromId      String?
  expiryNotifiedDays Int[] @default([])

  ownerPartyId String?
  documentId   String?
  approvedById String?
  approvedAt   DateTime?

  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, status, endDate])
  @@index([tenantId, partnerOrganizationId])
  @@map("partner_agreements")
}

/// A structured post-mortem, mandatory above a value OR strategic threshold —
/// an OR, not an AND — capturing named competitor, real decision-maker, and
/// real lost stage, feeding Company Memory's LESSON distillation.
model WinLossReview {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  subjectType String // opportunity | mou
  subjectId   String
  subjectLabel String?

  outcome        String
  competitorName String?
  decisionMakerPersonId String?
  realLostStage  String?
  lostReason     String?
  lostReasonOtherText String?
  lesson         String?

  /// Frozen at terminal-state entry: an edit to the live subject's
  /// strategic_value afterward never retroactively changes `mandatory`.
  mandatory                 Boolean  @default(false)
  mandatoryBasis            String   @default("not_mandatory")
  strategicValueSnapshot    String?
  commercialValueSnapshot   Decimal? @db.Decimal(18, 2)
  thresholdUsedSnapshot     Decimal? @db.Decimal(18, 2)

  completedById String?
  completedAt   DateTime?
  dueAt         DateTime?
  overdueNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, recordCode])
  @@unique([tenantId, subjectType, subjectId])
  @@index([tenantId, mandatory, completedAt])
  @@map("win_loss_reviews")
}

// ===========================================================================
// Interaction (the universal join table)
// ===========================================================================

/// The polymorphic successor to Activity — one write, many timelines,
/// extensible past CRM's own entity types to any domain without CRM code being
/// touched again.
model Interaction {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  /// Immutable post-creation.
  interactionType String
  direction       String @default("outbound")
  /// Immutable post-creation.
  occurredAt      DateTime

  actorPartyId        String?
  participantPartyIds String[] @default([])

  durationMinutes Int?
  subject         String?
  notes           String?
  outcome         String?

  /// An array of {contextCode, entityType, entityId} triples, minimum length 1.
  /// Replaces the seven fixed foreign keys. Each element may carry a
  /// denormalised, non-authoritative displayLabel/recordCode for render
  /// performance — never authoritative for permission decisions.
  relatedReferences Json

  /// Computed as the maximum classification across every related reference,
  /// re-evaluated at every read. Never set by the logging user. Persisted
  /// denormalised for indexing and reporting only.
  sensitivityClass String @default("internal")

  nextAction      String?
  nextActionDue   DateTime?
  attachmentDocumentIds String[] @default([])
  messageIds      String[] @default([])

  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, occurredAt])
  @@index([tenantId, sensitivityClass])
  @@index([tenantId, actorPartyId])
  @@map("interactions")
}

/// Each context registers the sensitivity of its own entity types. An
/// entity_type with no registration defaults to `confidential`, not `internal`,
/// and raises S1_ATTENTION — defaulting to internal means every new column
/// ships readable.
model SensitivityRegistration {
  id       String @id @default(cuid())
  tenantId String

  contextCode String
  entityType  String
  sensitivityClass String
  registeredById String?

  createdAt DateTime @default(now())

  @@unique([tenantId, contextCode, entityType])
  @@map("sensitivity_registrations")
}

model Task {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  title       String
  description String?
  status      String @default("open") // open | in_progress | done | cancelled
  priority    String @default("normal")

  assigneePartyId String?
  ownerPartyId    String?
  dueAt           DateTime?
  completedAt     DateTime?

  relatedInteractionId String?
  relatedType String?
  relatedId   String?

  escalatedAt DateTime?
  overdueNotifiedAt DateTime?

  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, assigneePartyId, status])
  @@index([tenantId, dueAt, status])
  @@map("tasks")
}

// ===========================================================================
// Documents
// ===========================================================================

/// File metadata only — binaries live in object storage, never in the database.
/// A re-upload creates a new row with an incremented version under the same
/// documentGroupId; it never overwrites the storage object.
model Document {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  filename   String
  storageKey String
  mimeType   String
  size       Int

  attachedToType String
  attachedToId   String

  version         Int    @default(1)
  documentGroupId String

  /// Drives per-kind signed-URL TTL, replacing the fixed 300-second constant.
  documentKind String @default("file_artefact")
  label        String?
  sensitivityClass String @default("internal")

  uploadedById String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, attachedToType, attachedToId])
  @@index([tenantId, documentGroupId, version])
  @@map("documents")
}

model Note {
  id       String @id @default(cuid())
  tenantId String

  body           String
  attachedToType String
  attachedToId   String
  authorPartyId  String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId, attachedToType, attachedToId])
  @@map("notes")
}

// ===========================================================================
// Finance (fin-owned)
// ===========================================================================

model Invoice {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  accountId      String?
  organizationId String?
  contractId     String?
  opportunityId  String?

  status     String @default("draft")
  currency   String @default("INR")
  issuedDate DateTime?
  dueDate    DateTime?

  /// Regulated — structurally excluded from CRM's receivables projection
  /// entirely, not merely nulled at render time.
  taxRegistrationReference String?

  overdueNotifiedAt DateTime?
  createdById String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lines    InvoiceLine[]
  receipts Receipt[]

  @@unique([tenantId, recordCode])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, accountId])
  @@map("invoices")
}

model InvoiceLine {
  id       String @id @default(cuid())
  tenantId String

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  offeringId  String?
  description String
  quantity    Int     @default(1)
  amount      Decimal @db.Decimal(18, 2)
  /// Derived from OFFERING.defaultRevenueTreatment — never asked of sales per deal.
  revenueMethod String

  createdAt DateTime @default(now())

  @@index([tenantId, invoiceId])
  @@map("invoice_lines")
}

/// The parallel obligation entity for the education motion — a sibling
/// structure to Invoice, not a variant of it.
model FeeInstalment {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  enrollmentId String
  feePlanId    String?
  amount       Decimal @db.Decimal(18, 2)
  currency     String  @default("INR")
  dueDate      DateTime
  status       String  @default("scheduled")

  overdueNotifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receipts Receipt[]

  @@unique([tenantId, recordCode])
  @@index([tenantId, status, dueDate])
  @@map("fee_instalments")
}

/// The money-movement fact — append-only, gateway-authoritative, idempotent on
/// gatewayReference. Never updated in place; corrections are new rows. May
/// exist before its resolving obligation is even issued.
model Payment {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  amount   Decimal @db.Decimal(18, 2)
  currency String  @default("INR")
  gatewayReference String
  receivedAt DateTime
  status     String @default("received")
  method     String @default("bank_transfer")

  /// Regulated — never included in CRM's receivables projection at all.
  bankAccountReference String?

  payerOrganizationId String?
  payerPersonId       String?
  reversalOfPaymentId String?
  note                String?

  /// The idempotency marker CRM-FIN-001 adds so the overdue-notification job
  /// stops re-notifying the same pending payment on every hourly tick.
  pendingLastNotifiedAt DateTime?

  createdAt DateTime @default(now())

  receipts Receipt[]

  @@unique([tenantId, gatewayReference])
  @@unique([tenantId, recordCode])
  @@index([tenantId, receivedAt])
  @@index([tenantId, status])
  @@map("payments")
}

/// The allocation join — many-to-many between Payment and
/// Invoice/FeeInstalment. Only the sum of a subject's allocated amounts
/// determines what has actually been paid against it. This is what finally
/// makes partial payments and credit notes representable.
model Receipt {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  invoiceId       String?
  invoice         Invoice? @relation(fields: [invoiceId], references: [id])
  feeInstalmentId String?
  feeInstalment   FeeInstalment? @relation(fields: [feeInstalmentId], references: [id])

  allocatedAmount Decimal  @db.Decimal(18, 2)
  allocatedAt     DateTime @default(now())
  allocatedById   String?

  createdAt DateTime @default(now())

  @@unique([tenantId, recordCode])
  @@index([tenantId, paymentId])
  @@index([tenantId, invoiceId])
  @@map("receipts")
}

/// The only permitted correction to an issued invoice line — an
/// obligation-reducing fact, structurally distinct from a payment-side reversal
/// so the two are never re-conflated the way a `refunded` status conflated them.
model CreditNote {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  invoiceId String
  amount    Decimal @db.Decimal(18, 2)
  currency  String  @default("INR")
  reason    String
  issuedAt  DateTime @default(now())
  issuedById String?

  createdAt DateTime @default(now())

  @@unique([tenantId, recordCode])
  @@index([tenantId, invoiceId])
  @@map("credit_notes")
}

/// A lightweight, disposable receivables summary per account/opportunity,
/// hydrated from Finance's event payloads. Explicitly non-authoritative — safe
/// to rebuild, discard or re-hydrate at any time, since CRM holds no
/// authoritative money state post-migration.
model ReceivablesProjection {
  id       String @id @default(cuid())
  tenantId String

  subjectType String
  subjectId   String
  subjectLabel String?

  amountOutstanding Decimal? @db.Decimal(18, 2)
  currency          String   @default("INR")
  nextDueDate       DateTime?
  dunningStage      String?

  hydratedAt DateTime @default(now())

  @@unique([tenantId, subjectType, subjectId])
  @@index([tenantId, dunningStage])
  @@map("receivables_projections")
}

// ===========================================================================
// Education (edu)
// ===========================================================================

model Course {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  name        String
  code        String
  description String?
  durationWeeks Int?
  offeringId  String?
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cohorts Cohort[]

  @@unique([tenantId, recordCode])
  @@unique([tenantId, code])
  @@map("courses")
}

model Cohort {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  name           String
  startDate      DateTime
  endDate        DateTime?
  trainerPartyId String?
  institutionId  String?
  capacity       Int      @default(30)
  status         String   @default("planned")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments Enrollment[]

  @@unique([tenantId, recordCode])
  @@index([tenantId, trainerPartyId])
  @@map("cohorts")
}

model Enrollment {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String
  legacyReference String?

  personId  String
  cohortId  String
  cohort    Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  opportunityId String?

  status         String    @default("reserved")
  enrolledAt     DateTime?
  completedAt    DateTime?
  progressPct    Int       @default(0)
  attendancePct  Int       @default(100)
  atRisk         Boolean   @default(false)
  atRiskNotifiedAt DateTime?

  /// Regulated (DPDP-covered) — read-audited, never masked-but-present.
  guardianName  String?
  guardianPhone String?
  guardianEmail String?
  isMinor       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance    Attendance[]
  dailyProgress DailyProgress[]

  @@unique([tenantId, recordCode])
  @@index([tenantId, cohortId, status])
  @@index([tenantId, personId])
  @@map("enrollments")
}

/// An explicit collection name is set on all three education operational models
/// as defence-in-depth, so a future model rename can never silently change the
/// live collection out from under a migration.
model Attendance {
  id       String @id @default(cuid())
  tenantId String

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  sessionDate DateTime
  status      String
  recordedById String?
  note        String?

  createdAt DateTime @default(now())

  @@unique([enrollmentId, sessionDate])
  @@index([tenantId, sessionDate])
  @@map("attendances")
}

model DailyProgress {
  id       String @id @default(cuid())
  tenantId String

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  progressDate DateTime
  score        Int?
  note         String?
  recordedById String?

  createdAt DateTime @default(now())

  @@index([tenantId, enrollmentId, progressDate])
  @@map("daily_progresses")
}

// ===========================================================================
// Projects (prj) — the record a project manager actually needs, post-award
// ===========================================================================

model Project {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  name           String
  organizationId String?
  opportunityId  String?
  contractId     String?
  managerPartyId String?

  status      String @default("planned") // planned | active | on_hold | delivered | closed
  startDate   DateTime?
  targetEndDate DateTime?
  actualEndDate DateTime?
  healthBand  String  @default("stable")
  scheduleVariancePct Int @default(0)

  /// Set when a won-opportunity handoff has not yet been accepted (EX-CRM-012).
  handoffAcceptedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, status])
  @@map("projects")
}

// ===========================================================================
// Exception engine (xcp) & notifications
// ===========================================================================

/// A record in an actionable bad state. An accountable owner is always resolved
/// BEFORE any notification fires. Escalation is bounded to exactly four named
/// triggers.
model ExceptionRecord {
  id         String @id @default(cuid())
  tenantId   String
  recordCode String

  code     String
  label    String
  severity String
  state    String @default("open")

  subjectType  String
  subjectId    String
  subjectLabel String?
  domain       String @default("crm")
  detail       String?
  reasonCode   String?

  ownerPartyId         String?
  accountablePositionId String?
  /// Set when the routing engine failed to resolve an owner — itself a
  /// first-class, measured category feeding H_OPS, never a blank assignee.
  ownerUnresolved      Boolean @default(false)

  raisedAt       DateTime  @default(now())
  acknowledgedAt DateTime?
  acknowledgedById String?
  resolvedAt     DateTime?
  resolvedById   String?
  resolutionNote String?

  slaDueAt        DateTime?
  escalatedAt     DateTime?
  escalationRung  Int      @default(0)
  escalationTrigger String?
  escalatedToPartyId String?

  /// (automationVersionId, subjectRef, triggerFingerprint, ladderRung)
  triggerFingerprint String?
  ladderRung         Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, recordCode])
  @@index([tenantId, state, severity, raisedAt])
  @@index([tenantId, ownerPartyId, state])
  @@index([tenantId, subjectType, subjectId])
  @@map("exception_records")
}

model Notification {
  id       String @id @default(cuid())
  tenantId String

  recipientPartyId String
  priority String @default("N2_NORMAL")
  channel  String @default("in_app")
  title    String
  body     String
  severity String?

  subjectType String?
  subjectId   String?
  drillPath   String?

  readAt      DateTime?
  dispatchedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, recipientPartyId, readAt])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

// ===========================================================================
// P5 — Automation substrate
// ===========================================================================

model AutomationDefinition {
  id       String @id @default(cuid())
  tenantId String

  jobName         String
  label           String
  automationClass String
  cronExpression  String  @default("0 * * * *")
  enabled         Boolean @default(true)
  /// In-flight firings keep their original definition version; new firings pick
  /// up the new one. No in-flight migration.
  version         Int     @default(1)
  accountablePositionId String?
  config          Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs JobRun[]

  @@unique([tenantId, jobName])
  @@map("automation_definitions")
}

model JobRun {
  id       String @id @default(cuid())
  tenantId String

  definitionId String
  definition   AutomationDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  automationVersionId String

  jobName    String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("running") // running | completed | failed
  processed  Int       @default(0)
  notified   Int       @default(0)
  skippedIdempotent Int @default(0)
  errors     String[]  @default([])
  dryRun     Boolean   @default(false)

  @@index([tenantId, jobName, startedAt])
  @@map("job_runs")
}

/// A firing with an already-recorded idempotency key does not re-execute. This
/// is a substrate-level guard IN ADDITION to each job's own per-record marker
/// fields, not a replacement for them.
model JobFiringLog {
  id       String @id @default(cuid())
  tenantId String

  automationVersionId String
  subjectRef          String
  triggerFingerprint  String
  ladderRung          Int    @default(0)

  jobRunId  String?
  firedAt   DateTime @default(now())
  outcome   String   @default("executed") // executed | skipped | failed

  @@unique([automationVersionId, subjectRef, triggerFingerprint, ladderRung])
  @@index([tenantId, firedAt])
  @@map("job_firing_logs")
}

// ===========================================================================
// P6 — Agent principals
// ===========================================================================

/// Every agent carries its own identity — never a shared service account, never
/// a role — and acts only through declared TOOLs.
model AgentPrincipal {
  id       String @id @default(cuid())
  tenantId String

  agentKey String
  name     String
  purpose  String
  /// The agent's ceiling tier. An individual action may classify lower but
  /// never higher.
  tier         String
  declaredTools String[] @default([])
  status       String   @default("active") // active | paused | revoked

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actions AgentAction[]

  @@unique([tenantId, agentKey])
  @@map("agent_principals")
}

model AgentAction {
  id       String @id @default(cuid())
  tenantId String

  agentId String
  agent   AgentPrincipal @relation(fields: [agentId], references: [id], onDelete: Cascade)

  tool   String
  action String
  tier   String

  subjectType String
  subjectId   String
  proposal    Json
  rationale   String

  state String @default("proposed") // proposed | accepted | rejected | executed | blocked
  blockedReason String?

  /// When acting for a person, the agent carries this rather than assuming a role.
  onBehalfOfPartyId String?
  humanActorId      String?
  decidedAt         DateTime?

  proposedAt DateTime @default(now())

  @@index([tenantId, agentId, proposedAt])
  @@index([tenantId, state])
  @@map("agent_actions")
}

// ===========================================================================
// Analytics, health, memory
// ===========================================================================

model KpiReading {
  id       String @id @default(cuid())
  tenantId String

  domainCode String
  metric     String
  dimensions Json     @default("{}")
  value      Float
  target     Float?
  asOf       DateTime
  computedAt DateTime @default(now())

  @@index([tenantId, domainCode, metric, asOf])
  @@map("kpi_readings")
}

model HealthScore {
  id       String @id @default(cuid())
  tenantId String

  domainCode String
  asOf       DateTime
  score      Float?
  band       String?
  /// {factor, weight, value, target, factorScore, contribution, quarantined}
  factors    Json    @default("[]")
  /// A domain with insufficient inputs renders "not yet measured", never a zero.
  state      String  @default("measured")
  policyVersionId String?

  computedAt DateTime @default(now())

  @@unique([tenantId, domainCode, asOf])
  @@index([tenantId, domainCode, asOf])
  @@map("health_scores")
}

/// The flat (date, metric, dimensions, value) upsert model — a deliberately
/// minimal design preserved as-is. `pipeline_value`/`pipeline_count` stop being
/// written; historical rows are retained, never deleted, as a point-in-time
/// record of the old formula.
model DailyMetric {
  id       String @id @default(cuid())
  tenantId String

  date       DateTime
  metric     String
  dimensions Json     @default("{}")
  value      Float
  computedAt DateTime @default(now())

  /// Set on the two retired metrics so a reader knows the formula was defective.
  retired Boolean @default(false)

  @@index([tenantId, date, metric])
  @@map("daily_metrics")
}

/// P8 — a lesson distilled from a win/loss review or a decision review.
model Lesson {
  id       String @id @default(cuid())
  tenantId String

  sourceType String
  sourceId   String
  title      String
  body       String
  domain     String   @default("crm")
  tags       String[] @default([])

  createdById String?
  createdAt   DateTime @default(now())

  @@index([tenantId, domain, createdAt])
  @@map("lessons")
}

/// P8 — the AI-authored prose the Command Center leads with past the narrative
/// window. Every claim resolves to an admitted delta item.
model Narrative {
  id       String @id @default(cuid())
  tenantId String

  forUserId          String
  windowFrom         DateTime
  windowTo           DateTime
  reconciliationLine String
  body               String
  /// The delta item ids every claim resolves to.
  claimRefs          String[] @default([])

  createdAt DateTime @default(now())

  @@index([tenantId, forUserId, createdAt])
  @@map("narratives")
}

// ===========================================================================
// P9 — Surface composition
// ===========================================================================

model SurfaceTemplate {
  id       String @id @default(cuid())
  tenantId String

  templateKey String
  name        String
  archetype   String
  eligibleRoles String[] @default([])
  navGroup    String   @default("main")
  version     Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bindings WidgetBinding[]

  @@unique([tenantId, templateKey])
  @@map("surface_templates")
}

/// Seven mandatory declarations on every widget: data source, permission,
/// severity relevance, actions, drill target, mobile behaviour, empty state.
/// A non-empty actions[] is enforced at publish time — no dead metrics.
model WidgetDefinition {
  id       String @id @default(cuid())
  tenantId String

  widgetKey       String
  title           String
  dataSource      String
  requiredPermission String
  severityRelevance String  @default("S0_INFO")
  actions         Json     @default("[]")
  drillTarget     String
  mobileBehaviour String   @default("keep") // keep | drill_only | shed
  emptyState      String
  /// A routing target for an item nobody can act on, with an SLA — never omission.
  noActionFallback String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bindings WidgetBinding[]

  @@unique([tenantId, widgetKey])
  @@map("widget_definitions")
}

model WidgetBinding {
  id       String @id @default(cuid())
  tenantId String

  templateId String
  template   SurfaceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  widgetId   String
  widget     WidgetDefinition @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  position Int    @default(0)
  /// movable | removable | locked
  personalisationPolicy String @default("movable")
  config   Json   @default("{}")

  createdAt DateTime @default(now())

  @@unique([templateId, widgetId])
  @@index([tenantId, templateId, position])
  @@map("widget_bindings")
}

/// Unreachable nodes are unrendered, never merely disabled. Badge counts obey
/// the same five-axis filter as content — a badge number is never a permission leak.
model NavNode {
  id       String @id @default(cuid())
  tenantId String

  nodeKey  String
  label    String
  icon     String  @default("circle")
  path     String
  group    String  @default("main")
  parentKey String?
  position Int     @default(0)
  requiredPermission String?
  eligibleArchetypes String[] @default([])
  searchSynonyms     String[] @default([])

  createdAt DateTime @default(now())

  @@unique([tenantId, nodeKey])
  @@index([tenantId, group, position])
  @@map("nav_nodes")
}

/// Persisted so an auditor's "why wasn't X on his screen on 14 March" is
/// answerable without re-derivation. `withheld[]` uses the closed reason-code set.
model SurfaceComposition {
  id       String @id @default(cuid())
  tenantId String

  userId        String
  affiliationId String
  templateKey   String
  templateVersion Int
  policyVersionId String?

  widgets  Json @default("[]")
  withheld Json @default("[]")

  composedAt DateTime @default(now())

  @@index([tenantId, userId, composedAt])
  @@map("surface_compositions")
}

/// Tunable without a code change — every constant the corpus flags as
/// unvalidated ships as a row here from day one.
model Threshold {
  id       String @id @default(cuid())
  tenantId String

  thresholdKey String
  value        Float
  unit         String  @default("count")
  description  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, thresholdKey])
  @@map("thresholds")
}
