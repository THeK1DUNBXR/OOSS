/// Only APPROVED rows are ever resolved. DRAFT and HOLD exist so a pack can be
/// loaded and reviewed before it changes a payslip or a filing.
enum StatutoryRuleStatus {
  DRAFT
  APPROVED
  HOLD
}

/// Versioned statutory parameters. Values are data, not application constants.
/// A null tenantId is a platform pack row; tenant overrides remain possible.
/// Overlap of [effectiveFrom, effectiveTo) among APPROVED rows per (tenant, domain,
/// jurisdiction, key) is enforced by a partial EXCLUDE constraint in the migration,
/// which Prisma cannot model. DRAFT and HOLD rows do not resolve, so they may overlap:
/// a next-year rate can be staged while this year's open-ended rule is still APPROVED.
model StatutoryRule {
  id            String    @id @default(cuid())
  tenantId      String?
  domain        String
  key           String
  jurisdiction  String
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  value         Json
  /// Citation: notification, circular or gazette reference. Required non-blank
  /// by a CHECK in the migration.
  source        String

  status     StatutoryRuleStatus @default(DRAFT)
  /// The author, recorded so approval can refuse the author. Null only for rows
  /// written before this column existed; those cannot be approved until re-entered,
  /// because maker and checker cannot be shown to differ.
  createdBy  String?
  approvedBy String?
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, domain, key, jurisdiction, effectiveFrom])
  @@map("statutory_rules")
}

/// Provider-independent e-invoice lifecycle record. The signed response is
/// retained as a snapshot; corrections after cancellation eligibility are new
/// documents, not mutations to this record.
model EInvoiceSubmission {
  id        String @id @default(cuid())
  tenantId  String
  invoiceId String

  provider         String
  providerInstance String
  idempotencyKey   String
  status           String  @default("pending") // pending | submitted | failed | cancelled
  requestPayload   Json
  responsePayload  Json?
  errorCode        String?
  errorMessage     String?

  irn                   String?
  acknowledgementNumber String?
  acknowledgedAt        DateTime?
  submittedAt           DateTime?
  cancelledAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, invoiceId])
  @@index([tenantId, status])
  @@map("einvoice_submissions")
}

/// A payroll statutory line keeps statutory and voluntary contributions
/// separately identifiable for payslips and future filing exports.
model PayrollStatutoryLine {
  id                       String @id @default(cuid())
  tenantId                 String
  payrollRunId             String
  employmentRelationshipId String
  payPeriod                String

  statute          String
  contributionKind String // statutory | voluntary
  component        String
  amountMinor           BigInt
  ruleId           String?

  createdAt DateTime @default(now())

  @@index([tenantId, payrollRunId])
  @@index([tenantId, employmentRelationshipId, payPeriod])
  @@map("payroll_statutory_lines")
}

/// A tenant-level holder of a named duty, from one instant to another (round 27 c:
/// the statutory approver is resolved from this, never from a role name or a person
/// in code; round 23 d: who holds it is decided at onboarding).
///
/// Not AccessDuty: that row hangs off an access assignment, is unique per
/// assignment, and carries an expiry, not a start. It cannot say one holder per
/// tenant at a time. ACCESS-MODEL-PLAN.md:278 names the statutory approver as an
/// extra duty, and DECISIONS.md round 27 c names it as a tenant-level duty; the two
/// should be reconciled when onboarding names the holder.
/// At most one holder per (tenant, dutyKey) over any instant is an EXCLUDE
/// constraint in the migration, which Prisma cannot model.
model DutyAssignment {
  id       String @id @default(cuid())
  tenantId String
  /// A duty key. The statutory approver's key is STATUTORY_APPROVER_DUTY in
  /// domains/statutory.ts, and the owner has not named it.
  dutyKey  String
  /// The person holding the duty (AuthContext.partyId). Plain id, as
  /// AccessAssignment.personId is; checked by the domain when assigned.
  partyId  String

  effectiveFrom DateTime
  /// Null is open-ended. Ending a holder sets this; the row is kept as history.
  effectiveTo   DateTime?

  assignedBy String
  endedBy    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, dutyKey, effectiveFrom])
  @@map("duty_assignments")
}
