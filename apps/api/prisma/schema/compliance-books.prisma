// ===========================================================================
// Compliance — Books and audit (workstream D, docs/plan/compliance.md).
//
// New models only. The fields this workstream needs on pre-existing models
// (AuditRecord.hash/prevHash, Transaction.reconciledAt) were already added to
// main.prisma before this workstream started.
// ===========================================================================

/// A financial-year month, closed once its figures are settled. Independent of
/// GST's own period lock (`assertPeriodOpen`) — a period can be GST-open and
/// books-closed, or the reverse.
model AccountingPeriod {
  id       String         @id @default(cuid())
  tenantId String
  entityId String?
  startsOn DateTime?      @db.Date
  endsOn   DateTime?      @db.Date
  // Restrict, not Prisma's SET NULL default: a period detached from its entity
  // would be an orphan the books can no longer be read against. The baseline
  // migration (20260901000000_baseline) carries the same RESTRICT.
  entity   LedgerEntity?  @relation(fields: [entityId], references: [id], onDelete: Restrict)
  entries  JournalEntry[]
  balanceSnapshots AccountBalanceSnapshot[]

  /// "2025-26" (Apr-Mar).
  fy     String
  /// YYYY-MM.
  period String

  /// open | closing | closed | reopened
  status String @default("open")

  /// Two-step close: request-close (`edit`), then close (`approve`) by a
  /// different party — the proposer never approves.
  requestedById String?
  requestedAt   DateTime?
  closedById    String?
  closedAt      DateTime?
  reopenedById  String?
  reopenedAt    DateTime?
  reopenReason  String?

  /// The trial balance the period stood on at close — what a closed period
  /// actually said, kept even if the books move afterward.
  snapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, period])
  @@unique([tenantId, entityId, startsOn])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("cmp_accounting_periods")
}

/// The period-end balance of one account as the journal derived it when the
/// period was closed. A cache for the nightly drift check, never a source of
/// truth: balanceOf still sums journal_lines. A mismatch between a row and the
/// journal is raised, not corrected. Rows are insert-only for the application
/// role (no UPDATE or DELETE); a period closed again after a reopen gets a new
/// version, so an old row is never compared with a balance it did not describe.
model AccountBalanceSnapshot {
  id           String           @id @default(cuid())
  tenantId     String
  accountId    String
  periodId     String
  version      Int
  /// The last IST day of the period: the balance is as of this day.
  asOf         DateTime         @db.Date
  balanceMinor BigInt
  /// When the journal was summed for this row. The drift check trusts a row only
  /// if it was derived after the period's latest close.
  derivedAt    DateTime
  createdAt    DateTime         @default(now())
  /// Composite with tenantId: a snapshot can only name an account and a period of its own tenant.
  account      LedgerAccount    @relation(fields: [tenantId, accountId], references: [tenantId, id])
  period       AccountingPeriod @relation(fields: [tenantId, periodId], references: [tenantId, id])

  @@unique([tenantId, accountId, periodId, version])
  @@map("account_balance_snapshots")
}

/// A registered legal entity. It is explicit even for single-entity tenants so
/// journal history does not need an expensive retrofit when a group is formed.
model LedgerEntity {
  id           String             @id @default(cuid())
  tenantId     String
  code         String
  legalName    String
  gstin        String?
  pan          String?
  tan          String?
  stateCode    String
  baseCurrency String             @default("INR")
  periods      AccountingPeriod[]
  entries      JournalEntry[]
  employments  EmploymentRelationship[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("ledger_entities")
}

model JournalEntry {
  id             String            @id @default(cuid())
  tenantId       String
  entityId       String
  periodId       String
  entryNumber    String
  entryDate      DateTime          @db.Date
  postedAt       DateTime?
  status         String            @default("posted")
  narration      String
  sourceType     String
  sourceId       String?
  reversalOfId   String?
  reversedById   String?
  idempotencyKey String?
  entity         LedgerEntity      @relation(fields: [entityId], references: [id])
  period         AccountingPeriod  @relation(fields: [periodId], references: [id])
  lines          JournalLine[]
  /// Reversal state is the presence of a link row, never a status UPDATE
  /// (MONEY-LEDGER-CONTRACT decision 7). `status` and `reversedById` are the
  /// pre-link history of entries reversed before journal_reversals existed.
  reversedBy     JournalReversal[] @relation("ReversedEntry")
  reversalOf     JournalReversal[] @relation("ReversalEntry")

  @@unique([tenantId, entityId, entryNumber])
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, id])
  @@index([tenantId, entityId, entryDate])
  @@map("journal_entries")
}

model JournalLine {
  id              String        @id @default(cuid())
  tenantId        String
  entryId         String
  /// Composite with tenantId: a line can only name an entry of its own tenant.
  entry           JournalEntry  @relation(fields: [tenantId, entryId], references: [tenantId, id])
  lineNo          Int
  accountId       String
  account         LedgerAccount @relation(fields: [accountId], references: [id])
  amountMinor     BigInt
  currency        String        @default("INR")
  baseAmountMinor BigInt
  fxRate          Decimal?      @db.Decimal(18, 8)
  division        String?
  /// Composite with tenantId, as lineId is: a line can only name a cost centre of
  /// its own tenant. Null on lines that carry no cost-centre dimension, which
  /// the composite key does not check (MATCH SIMPLE). Before this FK the column
  /// was a plain string, so a line could name a cost centre that did not exist.
  costCentreId    String?
  costCentre      CostCentre?   @relation(fields: [tenantId, costCentreId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  projectId       String?
  partyId         String?
  taxCodeId       String?
  memo            String?
  /// The business line this line is earned or spent under. Required by post()
  /// on income and expense accounts; nullable on balance-sheet lines.
  lineId          String?
  businessLine    BusinessLine? @relation(fields: [tenantId, lineId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId, accountId, entryId])
  @@index([tenantId, partyId])
  @@index([tenantId, lineId])
  @@index([tenantId, costCentreId])
  @@map("journal_lines")
}

/// The link from a reversed entry to the entry that reverses it. Insert-only
/// (the app role has no UPDATE or DELETE, and a trigger refuses both for every
/// role). A reversal entry cannot itself be reversed: the database refuses it
/// in journal_reversal_guard, and post() refuses it first with a 409.
model JournalReversal {
  id              String       @id @default(cuid())
  tenantId        String
  reversedEntryId String
  reversalEntryId String
  reason          String
  createdAt       DateTime     @default(now())
  /// Party that posted the reversal. Null only for backfilled legacy rows.
  createdById     String?
  reversedEntry   JournalEntry @relation("ReversedEntry", fields: [tenantId, reversedEntryId], references: [tenantId, id])
  reversalEntry   JournalEntry @relation("ReversalEntry", fields: [tenantId, reversalEntryId], references: [tenantId, id])

  @@unique([tenantId, reversedEntryId])
  @@unique([tenantId, reversalEntryId])
  @@map("journal_reversals")
}

/// Which ledger account a posting role points at, for one scope, from one IST
/// day (contract FX-70, decision O3). The vocabulary is packages/shared
/// postingRules.ts; the mapping is the finance head's data, never a constant.
/// Insert-only for every role: a changed mapping is a new row with a later
/// effectiveFrom. A row with no covering window is an unmapped role, and the
/// resolver refuses it rather than choosing an account.
model LedgerPostingRole {
  id              String        @id @default(cuid())
  tenantId        String
  role            String
  /// '' for an unscoped role; a business line id, a payment mode, or a category id otherwise.
  scopeKey        String        @default("")
  ledgerAccountId String
  /// The first IST day the mapping applies (inclusive).
  effectiveFrom   DateTime      @db.Date
  /// The first IST day it no longer applies (exclusive). Null for an open-ended mapping.
  effectiveTo     DateTime?     @db.Date
  /// The party who entered the mapping. Required: a mapping nobody owns is the finding.
  setById         String
  setAt           DateTime      @default(now())
  /// Composite with tenantId: a mapping can only name an account of its own tenant.
  account         LedgerAccount @relation(fields: [tenantId, ledgerAccountId], references: [tenantId, id])

  @@unique([tenantId, role, scopeKey, effectiveFrom])
  @@map("ledger_posting_roles")
}

/// How long a class of record must be kept, and under what statute. Dated data
/// rather than a constant — the Companies Act retention norm and the DPDP
/// floor are each somebody else's decision, not this codebase's.
model RetentionPolicy {
  id       String @id @default(cuid())
  tenantId String

  entityType String
  years      Int
  basis      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, entityType])
  @@map("cmp_retention_policies")
}

/// A record the monthly retention sweep found past its floor. Flagged, never
/// deleted — the platform does not act on this list, a person does.
model RetentionReview {
  id       String @id @default(cuid())
  tenantId String

  entityType String
  entityId   String
  /// The date retention is measured from (the record's own date, not today).
  recordDate DateTime
  dueAt      DateTime

  /// flagged | reviewed | dismissed
  status String  @default("flagged")
  note   String?

  flaggedAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?

  @@unique([tenantId, entityType, entityId])
  @@index([tenantId, status])
  @@map("cmp_retention_reviews")
}

/// Where a ledger category or account lands in Schedule III's format. An
/// explicit row overrides the kind/ledgerGroup default; either may be null but
/// not both.
model ScheduleIIIMapping {
  id       String @id @default(cuid())
  tenantId String

  categoryId String?
  accountId  String?

  /// profit_and_loss | balance_sheet
  statement       String
  scheduleHead    String
  scheduleSubHead String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, categoryId, accountId])
  @@index([tenantId, statement])
  @@map("cmp_schedule_iii_mappings")
}

/// Schedule II useful life by asset class, dated so a notification change does
/// not rewrite history.
model ScheduleIIUsefulLife {
  id       String @id @default(cuid())
  tenantId String

  assetClass      String
  usefulLifeYears Int
  residualPercent Decimal  @default(5) @db.Decimal(5, 2)
  effectiveFrom   DateTime

  @@unique([tenantId, assetClass, effectiveFrom])
  @@map("cmp_schedule_ii_useful_life")
}

/// The Income-tax Act's block-of-assets WDV rate, dated the same way.
model IncomeTaxDepreciationBlock {
  id       String @id @default(cuid())
  tenantId String

  blockName     String
  ratePercent   Decimal  @db.Decimal(5, 2)
  effectiveFrom DateTime

  @@unique([tenantId, blockName, effectiveFrom])
  @@map("cmp_it_depreciation_blocks")
}

/// One row of an imported bank statement, matched against the ledger by
/// `matchBankLines`.
model BankStatementLine {
  id       String @id @default(cuid())
  tenantId String

  accountId String
  date      DateTime
  amount    Decimal  @db.Decimal(18, 2)
  /// in | out
  direction String
  reference String?
  narration String?

  matchedTransactionId String?
  matchedAt            DateTime?

  /// Identifies the line across re-imports of the same statement (books.ts
  /// statementLineKey). Null on lines imported before it existed, which the
  /// unique index allows to repeat.
  fingerprint String?

  createdAt DateTime @default(now())

  @@unique([tenantId, accountId, fingerprint])
  @@index([tenantId, accountId, date])
  @@index([tenantId, matchedAt])
  @@map("cmp_bank_statement_lines")
}
