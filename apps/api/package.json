{
  "name": "@kaizen/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:push": "prisma migrate deploy && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "DATABASE_URL=postgresql://validate:validate@localhost:5432/validate MIGRATION_DATABASE_URL=postgresql://validate:validate@localhost:5432/validate prisma validate",
    "db:drift": "test -n \"$SHADOW_DATABASE_URL\" || { echo 'SHADOW_DATABASE_URL is required' >&2; exit 1; } && prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force --skip-generate && prisma generate && tsx src/seed/index.ts",
    "generate": "prisma generate",
    "seed": "tsx src/seed/index.ts",
    "report:roleless": "tsx src/scripts/reportRoleless.ts",
    "tenant:create": "tsx src/seed/createTenant.ts",
    "division:spin-out": "tsx src/seed/spinOut.ts",
    "seed:course-catalog": "tsx src/seed/courseCatalog.ts",
    "grants:reconcile": "tsx src/seed/reconcileGrants.ts",
    "jobs:run": "tsx src/jobs/runOnce.ts",
    "statutory-pack": "tsx src/cli/statutoryPack.ts",
    "test": "vitest run",
    "test:quick": "vitest run --reporter=dot --bail=1",
    "test:books": "vitest run src/tests/books.test.ts",
    "test:invoicing": "vitest run src/tests/invoicing.test.ts",
    "test:hr": "vitest run src/tests/hr.test.ts src/tests/hrLifecycle.test.ts",
    "test:acceptance": "vitest run src/tests/acceptance.test.ts",
    "test:watch": "vitest",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "seed:demo": "tsx src/tests/fixtures/run.ts",
    "wipe": "tsx src/seed/wipe.ts"
  },
  "dependencies": {
    "@kaizen/semantic": "workspace:*",
    "@kaizen/shared": "workspace:*",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "croner": "^10.0.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "fast-xml-parser": "^5.11.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^10.4.0",
    "ulid": "^2.3.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
