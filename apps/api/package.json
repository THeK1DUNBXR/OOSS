{
  "name": "@kaizen/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:push": "prisma db push --skip-generate && prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma db push --force-reset --skip-generate && prisma generate && tsx src/seed/index.ts",
    "generate": "prisma generate",
    "seed": "tsx src/seed/index.ts",
    "tenant:create": "tsx src/seed/createTenant.ts",
    "division:spin-out": "tsx src/seed/spinOut.ts",
    "seed:course-catalog": "tsx src/seed/courseCatalog.ts",
    "grants:reconcile": "tsx src/seed/reconcileGrants.ts",
    "jobs:run": "tsx src/jobs/runOnce.ts",
    "statutory-pack": "tsx src/cli/statutoryPack.ts",
    "test": "vitest run",
    "test:quick": "vitest run --reporter=dot --bail=1",
    "test:books": "vitest run src/tests/books.test.ts",
    "test:invoicing": "vitest run src/tests/invoicing.test.ts",
    "test:hr": "vitest run src/tests/hr.test.ts src/tests/hrLifecycle.test.ts",
    "test:acceptance": "vitest run src/tests/acceptance.test.ts",
    "test:watch": "vitest",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "seed:demo": "tsx src/tests/fixtures/run.ts",
    "wipe": "tsx src/seed/wipe.ts"
  },
  "dependencies": {
    "@kaizen/semantic": "workspace:*",
    "@kaizen/shared": "workspace:*",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "croner": "^10.0.1",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "ulid": "^2.3.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "schema": "prisma/schema"
  }
}
