+  throw lastError instanceof Error
+    ? new Error(`Could not append to the event chain after ${CHAIN_RETRIES} attempts: ${lastError.message}`)
+    : new Error(`Could not append to the event chain after ${CHAIN_RETRIES} attempts.`);
+}
