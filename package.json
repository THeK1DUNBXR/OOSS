{
  "name": "kaierp",
  "version": "1.0.0",
  "private": true,
  "description": "KaiERP \u2014 the ERP platform of Kaizen Infinities: CRM, HRM, Finance and the Command Center as one system",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter @kaizen/shared build && pnpm --filter @kaizen/api build && pnpm --filter @kaizen/web build",
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @kaizen/api dev\" \"pnpm --filter @kaizen/web dev\"",
    "db:push": "pnpm --filter @kaizen/api db:push",
    "db:migrate": "pnpm --filter @kaizen/api db:migrate",
    "db:seed": "pnpm --filter @kaizen/api seed",
    "grants:reconcile": "pnpm --filter @kaizen/api grants:reconcile",
    "db:reset": "pnpm --filter @kaizen/api db:reset",
    "test": "pnpm --filter @kaizen/api test",
    "test:e2e": "pnpm --filter @kaizen/e2e test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && node scripts/check-tailwind-tokens.mjs --check",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "map:check": "node scripts/genmap.mjs --check",
    "jobs:run": "pnpm --filter @kaizen/api jobs:run",
    "setup": "pnpm install && pnpm --filter @kaizen/shared build && pnpm db:push && pnpm db:seed",
    "build:worker": "pnpm --filter @kaizen/shared build && pnpm --filter @kaizen/web build",
    "deploy": "pnpm run build:worker && wrangler deploy",
    "preview": "pnpm run build:worker && wrangler dev",
    "db:wipe": "pnpm --filter @kaizen/api wipe"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.0",
    "eslint": "^9",
    "prettier": "^3.9.6",
    "tailwindcss": "3.4.19",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8",
    "wrangler": "^4.130.0"
  }
}
