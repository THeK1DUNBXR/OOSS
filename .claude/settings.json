{
  "permissions": {
    "deny": [
      "Read(./pnpm-lock.yaml)",
      "Read(./**/dist/**)",
      "Read(./**/node_modules/**)",
      "Read(./**/.next/**)",
      "Read(./**/coverage/**)",
      "Read(./apps/api/src/tests/fixtures/demoDataset.ts)"
