{
  // The Cloudflare Worker that serves KaiERP's client.
  //
  // `pnpm build` produces apps/web/dist; this Worker serves it and forwards
  // /api to whatever API_ORIGIN points at. See worker/index.ts for why the
  // API itself is not on Workers — briefly: Prisma over TCP to PostgreSQL,
  // an interval-based job scheduler, and Express's Node stream model.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ooss",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // AsyncLocalStorage and the node: built-ins the client bundle does not use
  // but the runtime shims cheaply. Harmless here, and it removes a whole class
  // of "works locally, not on the edge" surprise if this Worker ever grows.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    // A deep link is a client route, not a missing file: /people/employees has
    // to return index.html so the router can handle it.
    "not_found_handling": "single-page-application"
  },

  "vars": {
    // Set this on the Worker (dashboard → Settings → Variables, or
    // `wrangler secret put` if it should not be public) to the URL of the
    // running API. Empty means every /api call returns a 503 that says so,
    // rather than failing in a way nobody can read.
    "API_ORIGIN": "",
    // Comma-separated portal hostnames (equity-portal plan §3.1). This
    // Worker does not route by host — it forwards every /api request to
    // API_ORIGIN regardless of which hostname it arrived on, and the client
    // decides the shell to render from what the API reports at
    // `/api/meta/version`. This var exists only so it can be set here too,
    // matching the API's own PORTAL_HOSTS (see docs/operations.md); the two
    // must agree, and neither is read from the other.
    "PORTAL_HOSTS": ""
  },

  "observability": {
    "enabled": true
  }

  // Once the portal hostname is chosen (equity-portal plan §1, answer 2), add
  // a `routes` entry so this same Worker also serves that host — one bundle,
  // one API, the hostname only ever selects a shell client-side:
  //
  // "routes": [
  //   { "pattern": "equity.example.com/*", "zone_name": "example.com" }
  // ]
}
